---
import MainPageLayout from '@layouts/MainPageLayout.astro';
import ImageModule from '@components/misc/ImageModule.astro';
import Cover from '@components/Cover.astro';
import { getRelativeLocaleUrl } from '@utils/urlUtils';

import { siteConfig } from '@/config'

import { i18n } from "astro:config/client";
import i18nit from '@i18n/translation'

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

console.log("404 page loaded with locale:", currentLang);

const pageTitle = "404 - " + siteConfig.title;
const indexPage = getRelativeLocaleUrl(currentLang, "/");
---
<MainPageLayout title={pageTitle} lang="zh-CN" noindex={true}>
    <div class="mx-auto w-full max-w-[var(--page-width)] px-4 text-center py-10">
        <div class="flex min-h-[65vh] flex-col items-center justify-center">

            <!-- 视觉主体：带光晕的渐变 404 -->
            <div class="relative select-none">
                <!-- 背景光晕 -->
                <div class="pointer-events-none absolute left-1/2 top-1/2 h-40 w-40 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--link-color)] opacity-20 blur-3xl"></div>

                <h1 class="relative bg-gradient-to-b from-[var(--link-color)] to-[var(--text-color-70)] bg-clip-text text-[clamp(5rem,18vw,10rem)] font-black leading-none tracking-tighter text-transparent">
                    404
                </h1>

                <!-- 装饰小点 -->
                <span class="absolute -left-2 top-6 h-1.5 w-1.5 rounded-full bg-[var(--link-color)] opacity-60"></span>
                <span class="absolute -right-1 bottom-10 h-1 w-1 rounded-full bg-[var(--link-color)] opacity-40"></span>
            </div>

            <!-- 文案 -->
            <h2 class="mt-2 text-lg font-semibold text-[var(--text-color)] sm:text-xl">
                {t("page404.title")}
            </h2>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-[var(--text-color-70)]">
                {t("page404.subTitle")}
            </p>

            <!-- 操作按钮 -->
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                <a href={indexPage}
                class="group inline-flex items-center gap-2 rounded-lg bg-[var(--link-color)] px-6 py-2.5 text-sm font-medium text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:opacity-90 hover:shadow-md">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 10.5 12 3l9 7.5"/>
                        <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"/>
                    </svg>
                    {t("page404.backToHome")}
                </a>

                <a href="javascript:history.back()"
                class="group inline-flex items-center gap-2 rounded-lg border border-[var(--button-border-color)] px-6 py-2.5 text-sm font-medium text-[var(--text-color)] transition duration-200 hover:-translate-y-0.5 hover:bg-[var(--button-hover-color)]">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5"/>
                        <path d="m12 19-7-7 7-7"/>
                    </svg>
                    {t("page404.backToPreview")}
                </a>
            </div>

        </div>
    </div>
</MainPageLayout>