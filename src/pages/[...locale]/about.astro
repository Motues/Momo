---
import MainPageLayout from '@layouts/MainPageLayout.astro'
import Markdown from '@components/misc/Markdown.astro'
import Cover from '@components/Cover.astro'
import FabMenu from '@components/control/FabMenu.astro'

import { getSpec } from '@utils/contentUtils'
import { absoluteUrl, normalizePath, profilePageJsonLd } from '@utils/seo'

import { siteConfig } from '@/config'
import i18nit from '@i18n/translation'
import { getEntry, render } from 'astro:content'
import { i18n } from "astro:config/client";

export async function getStaticPaths() {
	return i18n?.locales.map(locale => ({ params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) } }));
}


const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const aboutPost = await getSpec(currentLang, 'about');
if (!aboutPost) {
    throw new Error('No about post found');
}
const { Content, remarkPluginFrontmatter } = await render(aboutPost);

const pageTitle = t("header.about") + " - " + siteConfig.title;
// SEO：描述取该页 Cover 文案
const pageDescription = `${t("cover.title.about")} - ${t("cover.subTitle.about")}`;
const pageUrl = absoluteUrl(normalizePath(Astro.url.pathname));
// 关于页的结构化数据：ProfilePage + Person（站点主人）
const structuredData = profilePageJsonLd({ url: pageUrl, lang: currentLang, description: pageDescription });
---

<MainPageLayout
    title={pageTitle}
    lang={currentLang}
    description={pageDescription}
    structuredData={structuredData}
    markdownFont={true}
    mathStyles={remarkPluginFrontmatter.hasMath === true}
>
    <div class="mx-auto w-full max-w-[var(--page-width)]">
        <Cover title={t("cover.title.about")} subTitle={t("cover.subTitle.about")}/>
        <Markdown class="mb-6 markdown-content">
            <Content />
        </Markdown>
    </div>
    <!-- fixed 浮层：留在 swup 容器内，但在淡入淡出元素之外（见 MainPageLayout 的说明） -->
    <div slot="overlay">
        <FabMenu showBackBottom={true} />
    </div>
</MainPageLayout>