---
import MainPageLayout from '@layouts/MainPageLayout.astro';
import Cover from '@components/Cover.astro';
import PostPage from '@components/PostPage.astro';
import Navi from '@components/control/Navi.astro';
import FabMenu from '@components/control/FabMenu.astro';

import { getBlogEntrySort } from '@utils/contentUtils'
import { getSiteTitle } from '@utils/siteTitle';
import { siteConfig } from '@/config';
import { i18n } from "astro:config/client";
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getRelativeLocaleUrl } from '@utils/urlUtils';
import { photoCoverEnabled } from '@utils/photoCover';

import i18nit from '@i18n/translation'

// 所有分页数据都在 "page" 参数中传递
const { page } = Astro.props;
const { locale = i18n!.defaultLocale } = Astro.params;

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

export const getStaticPaths = (async ({ paginate }) => {

  function createPinTopSort() {
    return (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => {
      const pinTopA = a.data.pinTop ?? 0;
      const pinTopB = b.data.pinTop ?? 0;
      
      if (pinTopA > 0 && pinTopB > 0) {
        return pinTopB - pinTopA;
      }
      
      if (pinTopA > 0) return -1;
      if (pinTopB > 0) return 1;
      
      return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
    };
  }

  // 如果启用了国际化，为每个语言环境生成分页路径
  const paths = [];
  for (const locale of i18n.locales) {
    const localeCode = typeof locale === 'string' ? locale : locale.path;
    const localeParam = localeCode === i18n.defaultLocale ? undefined : localeCode;
    const blogEntries = await getBlogEntrySort(localeParam, undefined, createPinTopSort());
    const paginatedPaths = paginate(blogEntries, { 
      pageSize: siteConfig.pageSize,
      params: { locale: localeParam }
    });
    
    // 将生成的路径添加到总路径列表中
    paths.push(...paginatedPaths);
  }
  
  return paths;
}) satisfies GetStaticPaths



const indexPage = getRelativeLocaleUrl(locale, '/');
// 副标题为空时标签栏只显示主标题；分页页追加页码，避免第 2 页起的标题完全重复
const pageTitle = page.currentPage > 1
    ? `${getSiteTitle()} (${page.currentPage})`
    : getSiteTitle();

// 照片封面只在首页第 1 页启用：翻页时再闪一次全屏大图反而吵。
// 内页也会有一层很淡的照片背景，但那是 MainPageLayout 里 PhotoCover 的默认状态。
const usePhotoCover = page.currentPage === 1 && photoCoverEnabled();
// 社交分享图用这张照片；放在 src/ 下的图片构建后地址不可知，只在站内 / 绝对地址时生效
const coverImage = siteConfig.theme.photoCover.image;
const shareImage = usePhotoCover && (coverImage.startsWith('/') || /^https?:\/\//.test(coverImage))
    ? coverImage
    : undefined;

---

<MainPageLayout title={pageTitle} lang={currentLang} image={shareImage} photoCover={usePhotoCover}>
    <Cover title={t("cover.title.home")} subTitle={t("cover.subTitle.home")} photo={usePhotoCover} />
    <PostPage page={page} />
    <Navi page={page} />
    <!-- fixed 浮层：留在 swup 容器内，但在淡入淡出元素之外（见 MainPageLayout 的说明） -->
    <div slot="overlay">
        <FabMenu showBackBottom={true} />
    </div>
</MainPageLayout>