---
import MainPageLayout from '@layouts/MainPageLayout.astro'
import { siteConfig, friendLinkConfig } from '@/config'
import Cover from '@components/Cover.astro';
import Markdown from '@components/misc/Markdown.astro';

import { getSpec } from '@utils/contentUtils'
import { DEFAULT_AVATAR_URL } from '@utils/avatar'

import i18nit from '@i18n/translation';
import { getEntry, render } from 'astro:content'
import { i18n } from "astro:config/client";

export async function getStaticPaths() {
	return i18n?.locales.map(locale => ({ params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) } }));
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const friendsPost = await getSpec(currentLang, 'friends');
if (!friendsPost) {
    throw new Error('No friends post found');
}
const { Content, remarkPluginFrontmatter } = await render(friendsPost);

const pageTitle = t("header.friends") + " - " + siteConfig.title;
// SEO：用该页 Cover 文案作为描述，避免多个页面共用同一段描述
const pageDescription = `${t("cover.title.friends")} - ${t("cover.subTitle.friends")}`;

// 友链卡片与首页文章卡片同一套入场：只有开启动画时输出 data-reveal，每张错峰 50ms（最多到第 6 张）
const revealAttrs = (index: number) => siteConfig.theme.AOS
    ? { 'data-reveal': 'pop', 'data-reveal-delay': String(Math.min(index, 5) * 50) }
    : {};
---

<MainPageLayout title={pageTitle} lang={currentLang} description={pageDescription} markdownFont={true} mathStyles={remarkPluginFrontmatter.hasMath === true}>
    <div class="mx-auto w-full max-w-[var(--page-width)]">
        <Cover title={t("cover.title.friends")} subTitle={t("cover.subTitle.friends")} />

        <!-- data-reveal 放在卡片外层：卡片自己的 transition-colors 不能被入场规则覆盖，否则悬停换底色会变成硬切 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-[var(--text-color)] mb-12">
            {
                friendLinkConfig.map((friend, index) => (
                    <div {...revealAttrs(index)} class="h-full">
                        <a
                            href={friend.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="momo-card group flex h-full items-center justify-between p-4 hover:bg-[var(--button-hover-color)] active:bg-[var(--button-hover-color)] transition-colors duration-300"
                        >
                            <div class="flex items-center min-w-0">
                                <img
                                    src={friend.avatar || DEFAULT_AVATAR_URL}
                                    alt={friend.name}
                                    width="64"
                                    height="64"
                                    loading="lazy"
                                    decoding="async"
                                    data-friend-avatar
                                    onerror={`this.onerror=null;this.src='${DEFAULT_AVATAR_URL}'`}
                                    class="w-16 h-16 rounded-full object-cover mr-4 flex-shrink-0"
                                />
                                <div class="min-w-0">
                                    <h2 class="font-bold text-lg truncate transition-colors duration-300 group-hover:text-[var(--link-color)] group-active:text-[var(--link-color)]">{friend.name}</h2>
                                    <p class="text-[var(--text-color-70)] text-sm truncate">{friend.description}</p>
                                </div>
                            </div>

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-5 h-5 text-[var(--link-color)] opacity-0 transform translate-x-[-10px] group-hover:opacity-100 group-hover:translate-x-0 group-active:opacity-100 group-active:translate-x-0 transition duration-300 ml-2 flex-shrink-0"
                            >
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                            </svg>
                        </a>
                    </div>
                ))
            }
        </div>
        <Markdown class="mb-6 markdown-content">
            <Content />
        </Markdown>
    </div>
</MainPageLayout>