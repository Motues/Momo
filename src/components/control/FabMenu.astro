---
import { Icon } from "astro-icon/components";
import { i18n } from "astro:config/client";
import i18nit from '@i18n/translation'
import type { MarkdownHeading } from 'astro';

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

interface Props {
  showBackTop?: boolean;
  showBackBottom?: boolean;
  showComment?: boolean;
  scrollToTopDistance?: number; // 滚动多少高度后显示菜单
  headings?: MarkdownHeading[]; // 接收 Astro 解析出来的目录数组
}

const { 
  showBackTop = true, 
  showBackBottom = false, 
  showComment = false,
  scrollToTopDistance = 100,
  headings = [] 
} = Astro.props;

// 只保留 h2 / h3 / h4（过滤 h1 与更深层级）
const tocHeadings = headings.filter(h => h.depth > 1 && h.depth < 5);
---

<div 
  id="fabMenu" 
  class="fixed bottom-[5vh] lg:bottom-[13.5vh] right-[7vw] lg:left-[var(--toc-offset-left)] w-10 h-10 z-[var(--momo-z-fab)] pointer-events-none"
  data-scroll-distance={scrollToTopDistance}
>
  <div id="menuItems" class="absolute bottom-full left-0 mb-3 flex flex-col items-center gap-3 transition duration-300 ease-out translate-y-10 pointer-events-none [.is-active_&]:translate-y-0 [.is-active_&]:pointer-events-auto">
    
    {showBackTop && (
      <button id="backTop" title={t("button.backToTop")} class="fab-item relative w-10 h-10 rounded-full border border-[var(--text-color)]/20 cursor-pointer flex items-center justify-center opacity-0 active:scale-90 shadow-none backdrop-blur bg-[var(--bg-color)]/20 hover:bg-[var(--button-hover-color)] [.is-active_&]:opacity-100">
        <svg class="absolute -top-[1px] -left-[1px] w-[calc(100%+2px)] h-[calc(100%+2px)] -rotate-90 overflow-visible" viewBox="0 0 40 40">
          <circle 
            id="progress-circle" 
            cx="20" cy="20" r="19" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2" 
            stroke-dasharray="0 119.4" 
            stroke-linecap="round"
          ></circle>
        </svg>
        <Icon name="fa6-solid:arrow-up" class="relative z-10 text-lg text-[var(--text-color)]" />
      </button>
    )}

    {tocHeadings.length > 0 && (
      <button id="tocTrigger" title={t("button.toc") || "目录"} class="fab-item lg:hidden w-10 h-10 rounded-full border border-[var(--text-color)]/20 cursor-pointer flex items-center justify-center opacity-0 active:scale-90 shadow-none backdrop-blur bg-[var(--bg-color)]/20 hover:bg-[var(--button-hover-color)] [.is-active_&]:opacity-100">
        <Icon name="fa6-solid:list-ul" class="text-lg text-[var(--text-color)]" />
      </button>
    )}

    {showBackBottom && (
      <button id="backBottom" title={t("button.backToBottom")} class="fab-item w-10 h-10 rounded-full border border-[var(--text-color)]/20 cursor-pointer flex items-center justify-center opacity-0 active:scale-90 shadow-none backdrop-blur bg-[var(--bg-color)]/20 hover:bg-[var(--button-hover-color)] [.is-active_&]:opacity-100">
        <Icon name="fa6-solid:arrow-down" class="text-lg text-[var(--text-color)]" />
      </button>
    )}

    {showComment && (
      <button id="backComment" title={t("button.backToComments")} class="fab-item w-10 h-10 rounded-full border border-[var(--text-color)]/20 cursor-pointer flex items-center justify-center opacity-0 active:scale-90 shadow-none backdrop-blur bg-[var(--bg-color)]/20 hover:bg-[var(--button-hover-color)] [.is-active_&]:opacity-100">
        <Icon name="material-symbols:comment-outline-rounded" class="text-lg text-[var(--text-color)]" />
      </button>
    )}
  </div>

  <button id="menuTrigger" title={t("button.meun")} class="w-full h-full rounded-full border border-[var(--text-color)]/20 cursor-pointer flex items-center justify-center opacity-0 transition duration-300 shadow-none backdrop-blur bg-[var(--bg-color)]/20 active:scale-95 hover:bg-[var(--button-hover-color)] [.is-visible_&]:opacity-100">
    <Icon name="fa6-solid:ellipsis" class="absolute text-lg text-[var(--text-color)] transition duration-300 opacity-100 rotate-0 [.is-active_&]:opacity-0 [.is-active_&]:rotate-90" />
    <Icon name="fa6-solid:xmark" class="absolute text-lg text-[var(--text-color)] transition duration-300 opacity-0 -rotate-90 [.is-active_&]:opacity-100 [.is-active_&]:rotate-0" />
  </button>

  {tocHeadings.length > 0 && (
    <div 
      id="tocPanel" 
      class="lg:hidden absolute bottom-25 right-0 lg:bottom-0 lg:left-14 w-60 lg:w-72 max-h-[60vh] flex flex-col bg-[var(--bg-color)]/95 backdrop-blur-lg border border-[var(--border-color)] rounded-[var(--momo-radius-xl)] shadow-[var(--momo-shadow-xl)] transition duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] origin-bottom-right lg:origin-bottom-left scale-50 opacity-0 pointer-events-none translate-y-4 lg:translate-y-0 lg:-translate-x-4 [.is-visible.toc-active_&]:scale-100 [.is-visible.toc-active_&]:opacity-100 [.is-visible.toc-active_&]:pointer-events-auto [.is-visible.toc-active_&]:translate-y-0 [.is-visible.toc-active_&]:translate-x-0 z-[var(--momo-z-fab)]"
    >
      <div class="px-4 py-3 border-b border-[var(--text-color)]/10 font-bold text-sm text-[var(--text-color)] flex justify-between items-center bg-[var(--button-hover-color)] rounded-t-2xl">
        <span>{t("button.toc")}</span>
        <button id="closeToc" class="opacity-50 hover:opacity-100 transition-opacity p-1">
          <Icon name="fa6-solid:xmark" class="text-sm text-[var(--text-color)]" />
        </button>
      </div>
      <div class="overflow-y-auto p-2 overscroll-contain flex-1 scrollbar-thin scrollbar-thumb-[var(--text-color)]/20 scrollbar-track-transparent">
        <ul class="flex flex-col text-sm space-y-1">
          {tocHeadings.map(h => (
            <li>
              <a 
                href={`#${h.slug}`} 
                class="toc-link block py-1.5 px-3 rounded-lg hover:bg-[var(--text-color)]/10 text-[var(--text-color)]/80 hover:text-[var(--text-color)] transition-colors duration-200 line-clamp-2"
                style={`margin-left: ${(h.depth - 2) * 0.8}rem`}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}
</div>

<script>
import { registerPageInit } from '@utils/pageInit';
import { subscribeScroll } from '@utils/scrollBus';

// 本脚本带 src（模块表去重 ⇒ 换页不会重跑），而 FabMenu 在 swup 容器内、每次换页 DOM 全新：
// 初始化挂在 registerPageInit 上，监听器统一存进全局注册表，每次先解绑再绑定。
function initFabMenu() {
  window.__momoFabMenu?.cleanup?.();

  const container = document.getElementById('fabMenu');
  const trigger = document.getElementById('menuTrigger');
  const backTop = document.getElementById('backTop');
  const backBottom = document.getElementById('backBottom');
  const backComment = document.getElementById('backComment');
  const progressCircle = document.getElementById('progress-circle');
  const tocTrigger = document.getElementById('tocTrigger');
  const closeToc = document.getElementById('closeToc');
  const tocLinks = document.querySelectorAll('.toc-link');
  
  if (!container || !trigger) return;

  const threshold = parseInt(container.dataset.scrollDistance) || 100;
  let isTocOpen = false;
  let scrollPosOnTocOpen = 0;

  // ---- 滚动处理：统一调度 + 缓存文档高度 + 进度条去抖 ----
  let docHeight = 0;
  // 上一次真正写进 DOM 的进度（百分比），变化小于 0.5% 时不再触碰样式
  let lastPercent = -1;
  let lastVisible = null;

  function measure() {
    docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
  }

  function updateScroll(scrollTop) {
    // FAB 显隐：切 is-visible（CSS 里对应 visibility）而不是 opacity，
    // 否则容器 opacity < 1 会成为 backdrop 根，内部按钮的 backdrop-blur 在动画期间失效。
    const visible = scrollTop > threshold;
    if (visible !== lastVisible) {
      lastVisible = visible;
      if (visible) {
        container.classList.remove('pointer-events-none');
        container.classList.add('is-visible', 'pointer-events-auto');
      } else {
        container.classList.add('pointer-events-none');
        container.classList.remove('is-visible', 'pointer-events-auto', 'is-active', 'toc-active');
        isTocOpen = false; // 回到顶部时同时关闭目录状态
      }
    }

    // 滑动页面时平滑关闭目录 (设置 50px 的缓冲阈值，防止误触)
    if (isTocOpen && Math.abs(scrollTop - scrollPosOnTocOpen) > 50) {
      isTocOpen = false;
      container.classList.remove('toc-active');
    }

    if (progressCircle && docHeight > 0) {
      const scrollPercent = Math.min(100, (scrollTop / docHeight) * 100);
      if (Math.abs(scrollPercent - lastPercent) >= 0.5 || scrollPercent === 100) {
        lastPercent = scrollPercent;
        const circumference = 2 * Math.PI * 20;
        const offset = circumference - (scrollPercent / 100) * circumference;
        progressCircle.style.strokeDasharray = `${circumference - offset} ${offset}`;
      }
    }
  }

  // 滚动统一走全局调度器（见 @utils/scrollBus）：一帧只读一次 scrollY
  const unsubscribeScroll = subscribeScroll(updateScroll);

  function handleResize() {
    measure();
    updateScroll(window.scrollY);
  }

  // 目录高亮观察器（换页时必须断开，否则会持续观察已卸载的标题节点）
  let tocObserver = null;

  trigger.onclick = (e) => {
    e.stopPropagation();
    container.classList.toggle('is-active');
    if (!container.classList.contains('is-active')) {
      isTocOpen = false;
      container.classList.remove('toc-active');
    }
  };

  if (tocTrigger) {
    tocTrigger.onclick = (e) => {
      e.stopPropagation();
      isTocOpen = !isTocOpen;
      container.classList.toggle('toc-active', isTocOpen);
      if (isTocOpen) {
        scrollPosOnTocOpen = window.scrollY || document.documentElement.scrollTop;
      }
    };
  }

  if (closeToc) {
    closeToc.onclick = (e) => {
      e.stopPropagation();
      isTocOpen = false;
      container.classList.remove('toc-active');
    };
  }

tocLinks.forEach(link => {
    link.onclick = (e) => {
      e.preventDefault(); // 阻止默认锚点跳转，改用平滑滚动
      
      tocLinks.forEach(l => l.classList.remove('is-active'));
      link.classList.add('is-active');

      const targetId = link.getAttribute('href').substring(1);
      const targetElement = document.getElementById(targetId);
      
      if (targetElement) {
        // 预留顶部导航栏的偏移量
        const offset = 60; 
        const bodyRect = document.body.getBoundingClientRect().top;
        const elementRect = targetElement.getBoundingClientRect().top;
        const elementPosition = elementRect - bodyRect;
        const offsetPosition = elementPosition - offset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });
        
        isTocOpen = false;
        container.classList.remove('toc-active');
      }
    };
  });

  const headingElements = Array.from(tocLinks)
    .map(link => document.getElementById(link.getAttribute('href').substring(1)))
    .filter(Boolean);

  if (headingElements.length > 0) {
    // 观察器参数：标题进入视窗顶部向下 10%~20% 的区域时触发
    const observerOptions = {
      root: null,
      rootMargin: '-10% 0px -80% 0px', 
      threshold: 0
    };

    tocObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          tocLinks.forEach(l => l.classList.remove('is-active'));
          const activeId = entry.target.id;
          const activeLink = document.querySelector(`.toc-link[href="#${activeId}"]`);
          if (activeLink) {
            activeLink.classList.add('is-active');
          }
        }
      });
    }, observerOptions);

    headingElements.forEach(el => tocObserver.observe(el));
  }

  if (backTop) {
    backTop.onclick = () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      container.classList.remove('is-active', 'toc-active');
      isTocOpen = false;
    };
  }

  if (backBottom) {
    backBottom.onclick = () => {
      window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
      container.classList.remove('is-active', 'toc-active');
      isTocOpen = false;
    };
  }

  if (backComment) {
    backComment.onclick = () => {
      const comments = document.getElementById('comments');
      comments.scrollIntoView({ behavior: 'smooth' });
      container.classList.remove('is-active', 'toc-active');
      isTocOpen = false;
    };
  }

  // 点击外部关闭所有展开项
  const onDocumentClick = (e) => {
    if (!container.contains(e.target)) {
      container.classList.remove('is-active', 'toc-active');
      isTocOpen = false;
    }
  };

  window.addEventListener('resize', handleResize, { passive: true });
  document.addEventListener('click', onDocumentClick);

  measure();
  updateScroll(window.scrollY);

  window.__momoFabMenu = {
    cleanup() {
      unsubscribeScroll();
      window.removeEventListener('resize', handleResize);
      document.removeEventListener('click', onDocumentClick);
      tocObserver?.disconnect();
      tocObserver = null;
    },
  };
}

// 首屏 + 每次换页（swup 下首屏没有 astro:page-load，见 @utils/pageInit）
registerPageInit(initFabMenu);
</script>

<style is:global>
  /* ⚠️ 带 backdrop-blur 的元素，出现 / 消失动画不能靠祖先的 opacity：
     祖先 opacity < 1 会成为 backdrop 根，后代毛玻璃整帧失效。
     分工：容器只做 visibility + transform，淡入淡出落在带 backdrop-blur 的元素自己身上。 */
  #fabMenu {
    /* visibility 是离散插值：显示立刻可见，隐藏等 300ms 过渡跑完，收起动画才完整 */
    visibility: hidden;
    transition: visibility 300ms;
  }
  #fabMenu.is-visible { visibility: visible; }

  /* 菜单项：淡入沿用 #menuItems 的 300ms ease-out，按压缩放保持 200ms + 默认缓动。
     ⚠️ 弹入 / 弹出由 #menuItems 的 transition 驱动（过渡 translate），这里只负责 opacity 与 scale。 */
  #fabMenu .fab-item {
    transition: opacity 300ms cubic-bezier(0, 0, 0.2, 1),
                scale 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  #progress-circle {
    stroke: var(--text-color);
    /* 阅读进度环：逐帧更新，只补间 t-fast */
    transition: stroke-dasharray var(--momo-t-fast) linear;
  }
  
  .scrollbar-thin::-webkit-scrollbar {
    width: 4px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(156, 163, 175, 0.5); 
    border-radius: 20px;
  }
  .toc-link.is-active {
    background-color: var(--button-hover-color) !important;
    color: var(--link-color) !important;
    font-weight: 600;
  }
</style>