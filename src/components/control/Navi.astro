---
import { i18n } from "astro:config/client";
import i18nit from '@i18n/translation'
import { getRelativeLocaleUrl } from '@utils/urlUtils';

const { page } = Astro.props;

const currentPage = page.currentPage;
const totalPages = page.lastPage;

const showPrevious = currentPage > 1;
const showNext = currentPage < totalPages;

// 逻辑：生成带省略号的页码数组
function getVisiblePages(current: number, total: number) {
  const delta = 1; 
  const range = [];
  const rangeWithDots = [];
  let l;

  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    }
  }

  for (let i of range) {
    if (l) {
      if (i - l === 2) {
        rangeWithDots.push(l + 1);
      } else if (i - l !== 1) {
        rangeWithDots.push('...');
      }
    }
    rangeWithDots.push(i);
    l = i;
  }
  return rangeWithDots;
}

const visiblePages = getVisiblePages(currentPage, totalPages);

const getPageUrl = (p: number) => {
  return p === 1 ? '/' : `/${p}/`;
};

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

// 样式类：整合了移动端和桌面端的差异
// 按压反馈统一交给 .press（见 styles/global.css），不再用 active:scale-90
const btnBaseClass = "press p-2 md:px-4 md:py-2 flex items-center border rounded-lg";
const btnActiveProps = "text-[var(--text-color)] hover:bg-[var(--button-hover-color)] border-[var(--button-border-color)]";
const btnDisabledProps = "text-[var(--text-color-30)] border-[var(--button-border-color)] opacity-40 cursor-not-allowed pointer-events-none";
---

<nav data-reveal="rise" aria-label={t("pageNavigation.label")} class="flex flex-row justify-between items-center gap-1 my-8 max-w-[var(--page-width)] mx-auto text-sm">
  
  <!-- 禁用态用 <span> 而不是 href="#": 后者仍然是可聚焦链接，点一下会把地址改成 #（还会写一条历史） -->
  {showPrevious ? (
    <a
      href={getRelativeLocaleUrl(currentLang, getPageUrl(currentPage - 1))}
      class={`${btnBaseClass} ${btnActiveProps}`}
      aria-label={t("a11y.previousPage")}
    >
      <svg class="w-5 h-5 md:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      <span class="hidden md:inline">{t("pageNavigation.previous")}</span>
    </a>
  ) : (
    <span class={`${btnBaseClass} ${btnDisabledProps}`} aria-disabled="true">
      <svg class="w-5 h-5 md:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      <span class="hidden md:inline">{t("pageNavigation.previous")}</span>
    </span>
  )}

  <div class="flex items-center gap-1 md:gap-2 flex-nowrap overflow-x-auto no-scrollbar">
    {visiblePages.map((p) => {
      if (p === '...') {
        return (
          <span class="w-8 h-8 md:w-10 md:h-10 flex items-center justify-center text-[var(--text-color-70)]">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="5" cy="12" r="1.5"/>
              <circle cx="12" cy="12" r="1.5"/>
              <circle cx="19" cy="12" r="1.5"/>
            </svg>
          </span>
        );
      }
      
      const isCurrent = p === currentPage;
      // 当前页不再是「指向自己的链接」：用 span + aria-current="page"，
      // 读屏软件会念「当前页」，键盘也不会多停一站。
      if (isCurrent) {
        return (
          <span
            aria-current="page"
            class="w-8 h-8 md:w-10 md:h-10 flex items-center justify-center rounded-lg border border-[var(--button-border-color)] font-bold text-[var(--text-color)]"
          >
            {p}
          </span>
        );
      }

      return (
        <a
          href={getRelativeLocaleUrl(currentLang, getPageUrl(p as number))}
          class="w-8 h-8 md:w-10 md:h-10 flex items-center justify-center rounded-lg border border-transparent text-[var(--text-color-70)] transition duration-200 hover:border-[var(--button-border-color)] hover:text-[var(--text-color)] active:bg-[var(--button-hover-color)] active:scale-90"
          aria-label={t("pageNavigation.goToPage", { page: p })}
        >
          {p}
        </a>
      );
    })}
  </div>

  {showNext ? (
    <a
      href={getRelativeLocaleUrl(currentLang, getPageUrl(currentPage + 1))}
      class={`${btnBaseClass} ${btnActiveProps}`}
      aria-label={t("a11y.nextPage")}
    >
      <span class="hidden md:inline">{t("pageNavigation.next")}</span>
      <svg class="w-5 h-5 md:ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  ) : (
    <span class={`${btnBaseClass} ${btnDisabledProps}`} aria-disabled="true">
      <span class="hidden md:inline">{t("pageNavigation.next")}</span>
      <svg class="w-5 h-5 md:ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </span>
  )}
</nav>

<style>
  /* 隐藏滚动条，确保在极端窄屏下也能滑动页码 */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>