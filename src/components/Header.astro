/** 比较路径时忽略末尾斜杠：/archives 与 /archives/ 视为同一页 */
const normalizePath = (path) => {
  const value = String(path || '/');
  return value.length > 1 ? value.replace(/\/+$/, '') : value;
};

/* ------------------------------------------------------------------
 * 桌面端顶栏的「当前页」底色块（#nav-indicator）
 *
 * 色块是导航条里一个独立的绝对定位元素，链接自己不再有 bg-*。
 * 切页时不是把旧底色淡出、新底色淡入，而是**一个色块平移过去**。
 *
 * 顶栏在 swup 容器之外、换页不重建，所以位置一律现量：
 *   1. 点击导航链接 → 立刻按目标链接滑过去（不等 swup 把新页面取回来，跟手）
 *   2. 每次换页 → syncPersistedHeader() 末尾按地址权威重算（刷新 / 前进后退 / 换语言）
 *   3. 换页被取消 → 回弹到真实的当前页
