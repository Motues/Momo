/**
 * 把色块移到指定链接上（不传则隐藏）。
 *
 * 尺寸用两个 getBoundingClientRect 相减得到，再减掉导航条自身的边框宽度：
 * 绝对定位的包含块是 padding box，而 rect 量的是 border box，漏掉这一条会整体偏 1px。
 * 链接的 rect 不含 mx-1 外边距，正好等于原来 bg-* 覆盖的范围，视觉上无变化。
 */
function moveNavIndicator(link) {
  const indicator = document.getElementById('nav-indicator');
  const list = document.getElementById('nav-bar-list');
  if (!indicator || !list) return;

  // 移动端整条导航是 hidden（#nav-bar 是 hidden md:flex），量不到就藏起来。
  // 没有当前页（文章详情等）同理。
  if (!link || !list.offsetWidth) {
    indicator.style.opacity = '0';
    return;
  }

  const listRect = list.getBoundingClientRect();
  const linkRect = link.getBoundingClientRect();
  const style = window.getComputedStyle(list);
  const x = linkRect.left - listRect.left - (parseFloat(style.borderLeftWidth) || 0);
  const y = linkRect.top - listRect.top - (parseFloat(style.borderTopWidth) || 0);

  // 四个链接同字号同内边距，top / height 实际是常量，写死即可（CSS 里也没给它们过渡）；
  // 需要过渡的只有水平位移与宽度 —— 四个文案宽度不同，颜色块要能拉伸
  indicator.style.top = `${y}px`;
  indicator.style.height = `${linkRect.height}px`;
  indicator.style.width = `${linkRect.width}px`;
  indicator.style.transform = `translateX(${x}px)`;
  indicator.style.opacity = '1';
}

/** 按当前地址把色块放回正确的位置（切页后 / 回弹时调用） */
function syncNavIndicator() {
  moveNavIndicator(activeNavLink());
}

function initNavIndicator() {
  const list = document.getElementById('nav-bar-list');
  if (!list) return;

  window.__momoNavIndicator?.cleanup?.();

  // 1. 点击：先乐观地滑过去，换页完成后由 syncPersistedHeader() 校正。
  //    只响应普通左键 —— 中键 / Ctrl 点击会开新标签页，页面并没有换，色块不能跟着动。
  const onClick = (event) => {
    if (event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element
      ? event.target.closest('#nav-bar-list a[data-i18n-path]')
      : null;
    if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
    moveNavIndicator(link);
  };
  list.addEventListener('click', onClick);

  // 2. 导航条尺寸一变就重量：视口缩放（含跨过 md 断点）、字体到位、换语言改文案。
  //    色块是绝对定位的，改它自己的宽度不会反过来触发 ResizeObserver，不会自激。
  let raf = 0;
  const observer = new ResizeObserver(() => {
    cancelAnimationFrame(raf);
    raf = window.requestAnimationFrame(syncNavIndicator);
  });
  observer.observe(list);

  // 3. 换页被取消（命中 swup ignore、用户打断等）：弹回真实的当前页
  const onVisitCancel = () => syncNavIndicator();
  document.addEventListener('swup:visit:cancel', onVisitCancel);

  window.__momoNavIndicator = {
    cleanup() {
      list.removeEventListener('click', onClick);
      document.removeEventListener('swup:visit:cancel', onVisitCancel);
      observer.disconnect();
      cancelAnimationFrame(raf);
    },
  };
