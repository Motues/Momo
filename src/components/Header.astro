/** 去掉语言前缀，得到与语言无关的路径（/en/friends/ -> /friends/） */
function withoutLocalePrefix(pathname) {
  const matched = LOCALES
    .filter((code) => code !== DEFAULT_LOCALE)
    .find((code) => pathname === `/${code}` || pathname.startsWith(`/${code}/`));
  // ⚠️ 前缀长度要算上开头那个斜杠：'/en/friends/'.slice(2) 是 'n/friends/'（错），
  // slice(3) 才是 '/friends/'。少算这一位会让换语言后落到 /n/... 这种 404 地址上。
  const rest = matched ? pathname.slice(matched.length + 1) : pathname;
