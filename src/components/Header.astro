<script is:inline define:vars={{ scriptUrl: baseUrl('/pagefind/pagefind.js') }}>
async function loadAndSearch(options) {
  const quiet = options?.quiet === true;

  // 1. 如果已经加载过了，直接返回
  if (window.pagefind && typeof window.pagefind.search === 'function') {
    return;
  }
  
  if (window.pagefindLoading) return;
  window.pagefindLoading = true;

  try {
    // 动态导入脚本
    const pagefind = await import(scriptUrl);
    await pagefind.options({ excerptLength: 20 });
    window.pagefind = pagefind;
    
    // 触发自定义事件，通知搜索组件：Pagefind 准备好了
    document.dispatchEvent(new CustomEvent('pagefind-ready'));
  } catch (error) {
    // 预取失败不打扰用户：真正的点击还会再试一次，并给出可见提示
    if (quiet) console.info('Pagefind 索引预取失败（不影响页面其它功能）:', error?.message ?? error);
    else console.error('Pagefind 加载失败:', error);
  } finally {
    window.pagefindLoading = false;
  }
}

// 2. 绑定到搜索按钮
// 顶栏是 persist 的，用 dataset 守卫避免同一按钮被重复绑定
function attachSearchListener() {
  const btn = document.getElementById('search-button');
  if (btn && btn.dataset.searchBound !== 'true') {
    btn.dataset.searchBound = 'true';
    btn.addEventListener('click', () => loadAndSearch({ quiet: false }), { once: true });
  }
}

// 兼容 Astro 的 View Transitions
document.addEventListener('astro:page-load', attachSearchListener);

// 3. 空闲时预取索引：首次点击搜索不再有几百毫秒空窗。
//    放到 idle 里执行，避免和首屏资源抢带宽；省流模式或慢网下不预取。
function prefetchPagefind() {
  if (window.__momoPagefindPrefetched) return;
  window.__momoPagefindPrefetched = true;

  const conn = navigator.connection;
  if (conn?.saveData) return;
  if (conn?.effectiveType && /(^|-)2g$/.test(conn.effectiveType)) return;

  const run = () => { if (!window.pagefind) loadAndSearch({ quiet: true }); };
  if (typeof window.requestIdleCallback === 'function') {
    window.requestIdleCallback(run, { timeout: 3000 });
  } else {
    setTimeout(run, 1200);
  }
}

document.addEventListener('astro:page-load', prefetchPagefind);
</script>
