 */
function syncPersistedHeader() {
  const pathname = window.location.pathname;
  const currentLang = currentLangFromUrl(pathname);
  // <html lang> 与地址不一致时以地址为准（swup 的 head 插件是「顺带」同步，不是真源）
  syncDocumentLang();

  // 1. 语言菜单：每个选项指向当前页面对应的语言版本，并高亮当前语言
  const menu = document.getElementById('language-menu');
  if (menu) {
    const basePath = withoutLocalePrefix(pathname);
    menu.querySelectorAll('.lang-option').forEach((link) => {
      const lang = link.dataset.lang;
      link.setAttribute('href', getRelativeLocaleUrl(lang, basePath));
      const isActive = lang === currentLang;
      link.classList.toggle('bg-[var(--button-hover-color)]', isActive);
      link.classList.toggle('hover:bg-[var(--button-hover-color)]', !isActive);
      link.querySelector('.lang-dot')?.classList.toggle('hidden', !isActive);
    });
  }

  // 2. logo 指向当前语言的首页
  document
    .querySelector('#main-header .header-logo a')
    ?.setAttribute('href', getRelativeLocaleUrl(currentLang, '/'));

  // 3. 导航链接（桌面端顶栏 + 移动端抽屉共用同一套 data 标记）
  document.querySelectorAll('[data-i18n-path]').forEach((link) => {
    link.setAttribute('href', getRelativeLocaleUrl(currentLang, link.getAttribute('data-i18n-path') || '/'));
  });

  // 4. 导航文案：每种语言的文案在构建时都渲染进了 data-i18n-labels，这里按当前语言取用
  document.querySelectorAll('[data-i18n-labels]').forEach((el) => {
    const raw = el.getAttribute('data-i18n-labels');
    if (!raw) return;
    let labels;
    try {
      labels = JSON.parse(raw);
    } catch {
      return;
    }
    const text = labels?.[currentLang];
    if (typeof text === 'string') {
      el.querySelector('[data-i18n-text]')?.replaceChildren(document.createTextNode(text));
    }
  });

  // 5. 导航选中态：服务端渲染时是落地页的判定，换页后必须重算
  const here = normalizePath(pathname);
  const isActiveLink = (link) => {
    const href = link.getAttribute('href');
    if (!href) return false;
    return normalizePath(new URL(href, window.location.origin).pathname) === here;
  };
  // 桌面端顶栏：选中态只记在 aria-current 上，底色交给独立的浮动色块（#nav-indicator）
  document.querySelectorAll('#nav-bar [data-i18n-path]').forEach((link) => {
    if (isActiveLink(link)) link.setAttribute('aria-current', 'page');
    else link.removeAttribute('aria-current');
  });
  // 移动端抽屉：选中项是「底色 + 主题色文字」（与 mobileNavLinkClass 保持一致）
  document.querySelectorAll('#mobile-menu-drawer [data-i18n-path]').forEach((link) => {
    const active = isActiveLink(link);
    link.classList.toggle('bg-[var(--button-hover-color)]', active);
    link.classList.toggle('text-[var(--link-color)]', active);
    link.classList.toggle('hover:bg-[var(--button-hover-color)]', !active);
    link.classList.toggle('hover:text-[var(--link-color)]', !active);
  });

  // 6. 移动端分类筛选的选中态与链接（含当前语言前缀）
  syncMobileCategoryFilter();

  // 7. 桌面端顶栏底色块：必须排在最后 —— 上面 3 / 4 步刚改过 href 与文案，
  //    链接宽度变了才量得准
  syncNavIndicator();
}

registerPageInit(syncPersistedHeader);

function initLanguageMenu() {
  const languageButton = document.getElementById('language-button');
  const languageMenu = document.getElementById('language-menu');

  if (!languageButton || !languageMenu) return;

  window.__momoLanguageMenu?.cleanup?.();

  // 顶栏在容器外不会重建，同一元素会被多次初始化，必须用 onclick 赋值
  languageButton.onclick = (e) => {
    e.stopPropagation();
    languageMenu.classList.toggle('hidden');
  };

  const onDocumentClick = (event) => {
    const target = event.target;
    if (target instanceof Node && !languageButton.contains(target) && !languageMenu.contains(target)) {
      languageMenu.classList.add('hidden');
    }
  };
  document.addEventListener('click', onDocumentClick);

  // 换页开始时收掉语言菜单（顶栏不重建，以前靠整页替换复位）
  const onVisitStart = () => languageMenu.classList.add('hidden');
  document.addEventListener('swup:visit:start', onVisitStart);

  window.__momoLanguageMenu = {
    cleanup() {
      document.removeEventListener('click', onDocumentClick);
      document.removeEventListener('swup:visit:start', onVisitStart);
    },
  };
}
registerPageInit(initLanguageMenu);

function initHeaderScroll() {
  const header = document.getElementById('main-header');
  if (!header) return;

  // 顶栏在容器外不会重建，但初始化会反复执行，必须先解绑上一次的滚动回调。
  // 原实现每次新建 onScroll 闭包再 removeEventListener，移除的是从未绑定过的函数，等于没解绑。
  window.__momoHeaderScroll?.cleanup?.();

  let lastScrollY = window.scrollY;
  let ticking = false;

  function updateHeader() {
    const currentScrollY = window.scrollY;
    const scrollDelta = currentScrollY - lastScrollY;

    if (window.innerWidth < 776) {
      if (currentScrollY <= 50) {
        header?.classList.remove('header-hidden');
      } 
      else if (scrollDelta > 0 && currentScrollY > 100) {
        header?.classList.add('header-hidden');
      } 
      else if (scrollDelta < 0) {
        header?.classList.remove('header-hidden');
      }
    } else {
      header?.classList.remove('header-hidden');
    }
    lastScrollY = currentScrollY;
    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      window.requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });

  window.__momoHeaderScroll = {
    cleanup() {
      window.removeEventListener('scroll', onScroll);
    },
  };
}

registerPageInit(initHeaderScroll);
</script>


