---
import { siteConfig } from '@/config'
import ImageLightbox from './ImageLightbox.astro'
// KaTeX 样式由 Layout.astro 按需挂载（检测见 src/plugins/remark-has-math.ts），不在这里静态 import
import '@fontsource-variable/jetbrains-mono'
import '@fontsource-variable/jetbrains-mono/wght-italic.css'
import '@styles/markdown.css'

interface Props {
  class?: string;
  /** 显式关闭正文子元素的入场动画（规范页的静态示例用） */
  noReveal?: boolean;
}
const className = Astro.props.class ?? ''
const noReveal = Astro.props.noReveal ?? false
---
<div data-search-content data-no-reveal={noReveal ? '' : undefined} class:list={['markdown-content', className]}>
    <slot/>
</div>

<script>
  import { registerPageInit } from '@utils/pageInit';

  function setupSpoilers() {
    const spoilers = document.querySelectorAll('.spoiler');
    
    spoilers.forEach(el => {
      // 幂等守卫：同一个元素只绑定一次
      if (el.dataset.spoilerBound === '1') return;
      el.dataset.spoilerBound = '1';

      let timeoutId = null;
      let clickTime = 0;
      let scrollHandler = null;

      const removeScrollHandler = () => {
        if (scrollHandler) {
          window.removeEventListener('scroll', scrollHandler);
          scrollHandler = null;
        }
      };

      el.addEventListener('click', () => {
        el.classList.add('revealed');
        clickTime = Date.now();

        if (timeoutId) clearTimeout(timeoutId);
        removeScrollHandler();

        const isMobile = window.innerWidth < 776;

        if (!isMobile) {
          // --- 桌面端：3 秒后自动模糊 ---
          timeoutId = setTimeout(() => {
            el.classList.remove('revealed');
          }, 3000);
        } else {
          // --- 移动端 (< 776px)：发生滚动且距点击已过 3 秒才收起 ---
          scrollHandler = () => {
            const timeElapsed = Date.now() - clickTime;
            
            if (timeElapsed >= 3000) {
              el.classList.remove('revealed');
              removeScrollHandler();
            }
          };

          window.addEventListener('scroll', scrollHandler, { passive: true });
        }
      });
    });
  }

  // 首屏 + 每次换页（swup 下首屏不会有 astro:page-load，见 @utils/pageInit）
  registerPageInit(setupSpoilers);

  // LQIP 图片淡入：关闭 LQIP 时没有 .lqip-markdown-img，这里是空操作
  function handleLqipImages() {
    const lqipImages = document.querySelectorAll('.lqip-markdown-img');
    lqipImages.forEach(img => {
      if (img.complete) {
        img.classList.add('lqip-loaded');
      } else {
        img.addEventListener('load', () => {
          img.classList.add('lqip-loaded');
        });
        img.addEventListener('error', () => {
          img.classList.add('lqip-loaded');
        });
      }
    });
  }

  registerPageInit(handleLqipImages);
</script>

<style is:global>
  /* 代码块样式由 Expressive Code 提供（astro-expressive-code + ec.config.mjs + siteConfig.expressiveCode），
     这里只补横向滚动 */
  pre {
    overflow-x: auto;
  }
</style>

<style is:global>
  .markdown-content section[data-footnotes] .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .markdown-content section[data-footnotes] a[data-footnote-backref]::before {
    content: none !important;
    display: none !important;
    border: none !important;
  }

  .markdown-content section[data-footnotes] {
    margin-top: 3rem;       
    padding-top: 1.5rem;    
    border-top: 1px dashed var(--button-border-color); 
    color: var(--text-color-70);         
    font-size: 0.875rem;    
  }

  .markdown-content section[data-footnotes] ol {
    list-style: none; 
    counter-reset: footnote-counter;
    padding-left: 0;        
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0; 
  }

  .markdown-content section[data-footnotes] li {
    counter-increment: footnote-counter; 
    line-height: 1.6;
    display: flex !important;
    align-items: flex-start; 
    position: relative !important; 
  }

  .markdown-content section[data-footnotes] li::before {
    content: "[" counter(footnote-counter) "]" !important; 
    display: inline-block !important;
    font-weight: 600;      
    color: var(--link-color); 
    width: 2rem;
    flex-shrink: 0;  
    text-align: left; 
    margin: 0 !important; 
    transform: none !important; 
  }

  .markdown-content section[data-footnotes] li p {
    display: inline !important; 
    margin: 0 !important;
    position: static !important; 
  }

  .markdown-content section[data-footnotes] a[data-footnote-backref] {
    display: inline-block !important;
    position: static !important; 
    color: var(--link-color) !important;
    text-decoration: none !important;
    margin-left: 0;
    transition: transform var(--momo-t-base) var(--momo-ease-out);
  }

  .markdown-content section[data-footnotes] a[data-footnote-backref]:hover {
    color: var(--link-color) !important;
    transform: translateX(-2px);
  }

  /* 脚注跳回时 :target 那一行闪一下。
     ⚠️ 0% 必须是淡蓝底，满色会让正文黑字只有 1.85:1、内嵌回跳链接与底色同色。 */
  @keyframes highlight-fade {
    0% {
      background-color: color-mix(in srgb, var(--link-color) 16%, transparent);
    }
    100% {
      background-color: transparent;
    }
  }

  .markdown-content section[data-footnotes] li:target {
    animation: highlight-fade 2s ease-out;
    border-radius: var(--momo-radius-xs);
  }
  .markdown-content sup a[data-footnote-ref]::before,
  .markdown-content sup a[data-footnote-ref]::after {
    content: none; 
    display: inline;
    position: static;
    border: none;
    transform: none;
  }

  .markdown-content sup a[data-footnote-ref] {
    display: inline !important; 
    position: static !important; 
    color: var(--link-color) !important; 
    font-size: 0.75rem; 
    font-weight: 600; 
    padding: 0 1px; 
    text-decoration: none !important;
    transition: color var(--momo-t-fast) var(--momo-ease-out);
  }

  .markdown-content sup a[data-footnote-ref]::before {
    content: "[" !important;
    display: inline !important;
    color: var(--link-color) !important; 
    margin-right: 1px;
  }

  .markdown-content sup a[data-footnote-ref]::after {
    content: "]" !important;
    display: inline !important;
    color: var(--link-color) !important;
    margin-left: 1px;
  }

  .markdown-content sup a[data-footnote-ref]:hover {
    filter: brightness(0.8) !important; 
  }

  .markdown-content p:has(sup a[data-footnote-ref]:target), 
  .markdown-content sup a[data-footnote-ref]:target {
    animation: highlight-fade 2s ease-out;
    border-radius: var(--momo-radius-xs);
  }
</style>


{ siteConfig.theme.PhotoSwipe && <ImageLightbox /> }