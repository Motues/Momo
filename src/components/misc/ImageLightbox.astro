---
/**
 * ImageLightbox —— 自研图片灯箱（替代 photoswipe 依赖）
 *
 * 支持：点击全屏、滚轮 / 按钮 / 双击 / 双指缩放、拖拽平移、
 *       前后切换（按钮 / 方向键 / 左右滑动 / 点击两侧）、Esc 关闭、说明文字与计数。
 * 只作用于 .markdown-content 里的正文图片（链接内的图片除外）。
 */
---

<div class="lightbox" id="momo-lightbox" role="dialog" aria-modal="true" aria-label="图片查看器" hidden>
  <div class="lightbox-backdrop" data-act="close"></div>

  <div class="lightbox-stage" id="lb-stage">
    <img class="lightbox-img" id="lb-img" alt="" draggable="false" decoding="async" />
  </div>

  <button class="lightbox-nav lightbox-prev" data-act="prev" type="button" aria-label="上一张" title="上一张 (←)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>
  <button class="lightbox-nav lightbox-next" data-act="next" type="button" aria-label="下一张" title="下一张 (→)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </button>

  <div class="lightbox-bar">
    <span class="lightbox-counter" id="lb-counter">1 / 1</span>
    <span class="lightbox-spacer"></span>
    <button class="lightbox-btn" data-act="zoom-out" type="button" aria-label="缩小" title="缩小 (-)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.2" y2="16.2"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
    </button>
    <span class="lightbox-zoom" id="lb-zoom">100%</span>
    <button class="lightbox-btn" data-act="zoom-in" type="button" aria-label="放大" title="放大 (+)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.2" y2="16.2"></line><line x1="8" y1="11" x2="14" y2="11"></line><line x1="11" y1="8" x2="11" y2="14"></line></svg>
    </button>
    <button class="lightbox-btn" data-act="reset" type="button" aria-label="原始大小" title="原始大小 (0)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9V5a2 2 0 0 1 2-2h4"></path><path d="M21 9V5a2 2 0 0 0-2-2h-4"></path><path d="M3 15v4a2 2 0 0 0 2 2h4"></path><path d="M21 15v4a2 2 0 0 1-2 2h-4"></path></svg>
    </button>
    <button class="lightbox-btn lightbox-close" data-act="close" type="button" aria-label="关闭" title="关闭 (Esc)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <p class="lightbox-caption" id="lb-caption"></p>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    /* 必须高于 FabMenu 容器（z-1000）与目录面板（z-1001），
       否则灯箱打开时右下角悬浮按钮会浮在遮罩之上 */
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    color: #fff;
    user-select: none;
  }

  .lightbox[hidden] { display: none; }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    cursor: zoom-out;
  }

  .lightbox-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }

  .lightbox-stage.is-zoomed { cursor: move; }
  .lightbox-stage.is-dragging { cursor: grabbing; }

  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    transform-origin: center center;
    will-change: transform;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .lightbox-stage.is-animating .lightbox-img {
    transition: transform 0.22s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .lightbox-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  }

  .lightbox-spacer { flex: 1; }

  .lightbox-counter,
  .lightbox-zoom {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.85);
    min-width: 3.2em;
    text-align: center;
  }

  .lightbox-btn,
  .lightbox-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .lightbox-btn { width: 34px; height: 34px; }
  .lightbox-btn:hover,
  .lightbox-nav:hover { background: rgba(255, 255, 255, 0.26); }

  .lightbox-btn svg { width: 18px; height: 18px; }
  .lightbox-nav svg { width: 26px; height: 26px; }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    width: 46px;
    height: 46px;
    transform: translateY(-50%);
    opacity: 0.65;
  }

  .lightbox-nav:hover { opacity: 1; }
  .lightbox-prev { left: 16px; }
  .lightbox-next { right: 16px; }

  .lightbox-nav[disabled] { opacity: 0.18; cursor: default; }

  .lightbox-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 14px 18px;
    text-align: center;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
    pointer-events: none;
  }

  .lightbox-caption:empty { display: none; }

  @media (max-width: 776px) {
    .lightbox-nav { width: 38px; height: 38px; }
    .lightbox-prev { left: 8px; }
    .lightbox-next { right: 8px; }
    .lightbox-bar { padding: 8px 10px; }
  }
</style>

<script>
  const MIN_SCALE = 1
  const MAX_SCALE = 8
  const DOUBLE_TAP_SCALE = 2.5

  interface LbItem { src: string; alt: string; caption: string }

  // 正文里可放大的图片（链接里的图片保持原有跳转行为）
  // 每次打开都遍历全文太浪费：按页面缓存一次，换页时失效
  let imagesCache: HTMLImageElement[] | null = null

  function contentImages(): HTMLImageElement[] {
    if (imagesCache) return imagesCache
    const container = document.querySelector('.markdown-content')
    if (!container) {
      imagesCache = []
      return imagesCache
    }
    imagesCache = Array.from(container.querySelectorAll('img')).filter(
      (img) => !img.closest('a') && !!(img.currentSrc || img.getAttribute('src')),
    )
    return imagesCache
  }

  function itemOf(img: HTMLImageElement): LbItem {
    const figure = img.closest('figure')
    return {
      src: img.currentSrc || img.getAttribute('src') || '',
      alt: img.getAttribute('alt') || '',
      caption: figure?.querySelector('figcaption')?.textContent?.trim() || '',
    }
  }

  function initLightbox() {
    // 换页后正文图片列表已经不同，缓存作废
    imagesCache = null

    const root = document.getElementById('momo-lightbox') as HTMLElement | null
    if (!root || root.dataset.ready === '1') return
    root.dataset.ready = '1'

    const stage = root.querySelector('#lb-stage') as HTMLElement
    const img = root.querySelector('#lb-img') as HTMLImageElement
    const counter = root.querySelector('#lb-counter') as HTMLElement
    const zoomLabel = root.querySelector('#lb-zoom') as HTMLElement
    const caption = root.querySelector('#lb-caption') as HTMLElement
    const bar = root.querySelector('.lightbox-bar') as HTMLElement

    let items: LbItem[] = []
    let index = 0
    let scale = MIN_SCALE
    let x = 0
    let y = 0
    let open = false
    let lastFocus: HTMLElement | null = null
    // 打开时点击的那张缩略图，关闭时飞回它的位置
    let sourceImage: HTMLImageElement | null = null
    let transitionSeq = 0
    // 拖拽 / 双指手势状态
    const pointers = new Map<number, { x: number; y: number }>()
    let dragging = false
    let moved = false
    let startX = 0
    let startY = 0
    let pinchStart = 0
    let pinchScale = MIN_SCALE
    // 打开前的 body overflow，关闭动画结束后再还原（见 restoreScroll）
    let lockedOverflow: string | null = null

    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value))

    function cancelAnimations(elements: Element[]) {
      elements.forEach((element) => {
        element.getAnimations().forEach((animation) => animation.cancel())
      })
    }

    // 打开灯箱时锁定页面滚动；记录原值，避免覆盖其它组件（如移动端菜单）的锁定状态
    function lockScroll() {
      if (lockedOverflow === null) lockedOverflow = document.body.style.overflow
      document.body.style.overflow = 'hidden'
    }

    function restoreScroll() {
      if (lockedOverflow === null) return
      document.body.style.overflow = lockedOverflow
      lockedOverflow = null
    }

    // 缩放后的图片不能拖出可视区域
    function clampPan() {
      const maxX = Math.max(0, (img.clientWidth * scale - stage.clientWidth) / 2)
      const maxY = Math.max(0, (img.clientHeight * scale - stage.clientHeight) / 2)
      x = clamp(x, -maxX, maxX)
      y = clamp(y, -maxY, maxY)
    }

    function render(animate = false) {
      stage.classList.toggle('is-animating', animate)
      stage.classList.toggle('is-zoomed', scale > MIN_SCALE)
      img.style.transform = transformOf()
      zoomLabel.textContent = `${Math.round(scale * 100)}%`
      if (animate) {
        window.setTimeout(() => stage.classList.remove('is-animating'), 240)
      }
    }

    function applyScale(next: number, originX = 0, originY = 0, animate = false) {
      const clamped = clamp(next, MIN_SCALE, MAX_SCALE)
      if (clamped === scale) return
      // 以光标（或屏幕中心）为锚点缩放
      const ratio = clamped / scale
      x = originX - (originX - x) * ratio
      y = originY - (originY - y) * ratio
      scale = clamped
      if (scale === MIN_SCALE) {
        x = 0
        y = 0
      } else {
        clampPan()
      }
      render(animate)
    }

    // ---- 动画辅助 ----
    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches

    function transformOf() {
      return `translate3d(${x}px, ${y}px, 0) scale(${scale})`
    }

    // 缩略图 -> 灯箱位置的 FLIP transform（等比缩放 + 位移）
    function flipTransform(from: DOMRect, to: DOMRect) {
      const dx = from.left + from.width / 2 - (to.left + to.width / 2)
      const dy = from.top + from.height / 2 - (to.top + to.height / 2)
      const ratio = Math.min(from.width / to.width, from.height / to.height)
      return `translate3d(${dx}px, ${dy}px, 0) scale(${clamp(ratio, 0.05, 8)})`
    }

    // 原缩略图当前是否还可见（用于关闭动画）
    function sourceRect(): DOMRect | null {
      const source = sourceImage
      if (!source || !source.isConnected) return null
      const rect = source.getBoundingClientRect()
      if (rect.width < 8 || rect.height < 8) return null
      if (rect.bottom < 0 || rect.top > window.innerHeight) return null
      return rect
    }

    function waitForImage() {
      if (img.complete && img.naturalWidth) return Promise.resolve()
      return new Promise<void>((resolve) => {
        const done = () => {
          img.removeEventListener('load', done)
          img.removeEventListener('error', done)
          resolve()
        }
        img.addEventListener('load', done, { once: true })
        img.addEventListener('error', done, { once: true })
      })
    }

    function preloadNeighbours() {
      for (const offset of [1, -1]) {
        const neighbour = items[(index + offset + items.length) % items.length]
        if (neighbour && neighbour.src !== img.getAttribute('src')) {
          const preload = new Image()
          preload.src = neighbour.src
        }
      }
    }

    function applyImage(item: LbItem) {
      scale = MIN_SCALE
      x = 0
      y = 0
      img.src = item.src
      img.alt = item.alt
      counter.textContent = `${index + 1} / ${items.length}`
      caption.textContent = item.caption || item.alt || ''
      render(false)
    }

    // 打开：从缩略图平滑放大到全屏
    async function openAt(position: number, source: HTMLImageElement) {
      items = contentImages().map(itemOf)
      if (!items.length) return
      sourceImage = source
      lastFocus = document.activeElement as HTMLElement | null
      open = true
      const seq = ++transitionSeq

      const thumbRect = source.getBoundingClientRect()
      index = clamp(position, 0, items.length - 1)
      applyImage(items[index])
      root.hidden = false
      root.setAttribute('aria-hidden', 'false')
      root.style.opacity = ''
      lockScroll()
      syncNav()
      preloadNeighbours()

      cancelAnimations([img, root, bar, caption])
      await waitForImage()
      if (!open || seq !== transitionSeq) return
      playOpenAnimation(thumbRect)
      ;(root.querySelector('.lightbox-close') as HTMLElement)?.focus()
    }

    function playOpenAnimation(thumbRect: DOMRect | null) {
      const reduced = reducedMotion()
      // 清掉上一次快速开关残留的动画（尤其是 fill: backwards 的工具栏动画）
      cancelAnimations([img, root, bar, caption])
      const to = img.getBoundingClientRect()
      const duration = reduced || !to.width ? 0 : 340

      if (duration && thumbRect) {
        img.animate(
          [
            { transform: flipTransform(thumbRect, to), opacity: 0.65 },
            { transform: transformOf(), opacity: 1 },
          ],
          { duration, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' },
        )
      }
      root.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: reduced ? 0 : 220,
        easing: 'ease-out',
      })
      bar.animate(
        [
          { opacity: 0, transform: 'translateY(-10px)' },
          { opacity: 1, transform: 'none' },
        ],
        { duration: reduced ? 0 : 260, delay: reduced ? 0 : 90, easing: 'ease-out', fill: 'backwards' },
      )
      caption.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: reduced ? 0 : 260,
        delay: reduced ? 0 : 120,
        easing: 'ease-out',
        fill: 'backwards',
      })
    }

    // 关闭：整层淡出 + 图片飞回缩略图
    // 关键点：动画必须带 fill: 'forwards'，且在动画真正结束之后才隐藏 / 还原滚动，
    // 否则动画一结束状态就回弹成不透明，隐藏前会闪一帧全黑遮罩
    function close() {
      if (!open) return
      open = false
      const seq = ++transitionSeq
      pointers.clear()
      dragging = false

      const reduced = reducedMotion()
      const thumbRect = sourceRect()
      const animations: Animation[] = []
      const finish = () => {
        // 关闭动画期间又被重新打开（动画被取消也会让 finished 结束），此时不要隐藏
        if (seq !== transitionSeq) return
        // 先隐藏再取消动画：取消 fill 效果时页面已完成隐藏，不会出现回弹闪烁
        root.hidden = true
        root.setAttribute('aria-hidden', 'true')
        root.style.opacity = ''
        img.removeAttribute('src')
        animations.forEach((animation) => animation.cancel())
        restoreScroll()
        // preventScroll：避免关闭时浏览器把焦点元素滚回视口导致页面跳动
        lastFocus?.focus?.({ preventScroll: true })
      }

      cancelAnimations([img, root, bar, caption])

      if (reduced || !thumbRect || !img.clientWidth) {
        finish()
        return
      }

      const from = img.getBoundingClientRect()
      const duration = 280
      animations.push(
        img.animate(
          [
            { transform: transformOf(), opacity: 1 },
            { transform: flipTransform(thumbRect, from), opacity: 0.35 },
          ],
          { duration, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' },
        ),
        root.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration,
          easing: 'ease-in',
          fill: 'forwards',
        }),
      )
      // 两个动画时长一致，等全部结束再隐藏；元素被移除时动画会被取消，allSettled 同样能兜底
      Promise.allSettled(animations.map((animation) => animation.finished)).then(finish)
    }

    // 前后切换：旧图滑出、新图滑入
    async function go(delta: number) {
      if (items.length < 2) return
      const seq = ++transitionSeq
      const next = (index + delta + items.length) % items.length
      const reduced = reducedMotion()

      scale = MIN_SCALE
      x = 0
      y = 0

      if (!reduced) {
        await img
          .animate(
            [
              { transform: transformOf(), opacity: 1 },
              { transform: `translate3d(${-delta * 44}px, 0, 0) scale(0.97)`, opacity: 0 },
            ],
            { duration: 150, easing: 'ease-in' },
          )
          .finished.catch(() => {})
        if (seq !== transitionSeq || !open) return
      }

      index = next
      applyImage(items[index])
      await waitForImage()
      if (seq !== transitionSeq || !open) return
      preloadNeighbours()

      if (!reduced) {
        img.animate(
          [
            { transform: `translate3d(${delta * 44}px, 0, 0) scale(0.97)`, opacity: 0 },
            { transform: transformOf(), opacity: 1 },
          ],
          { duration: 230, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' },
        )
      }
    }

    function syncNav() {
      const single = items.length <= 1
      root.querySelectorAll('.lightbox-nav').forEach((el) => {
        ;(el as HTMLButtonElement).disabled = single
      })
    }

    // ---- 打开：点击正文图片 ----
    function bindImages() {
      contentImages().forEach((image, position) => {
        if (image.dataset.lbBound === '1') return
        image.dataset.lbBound = '1'
        image.style.cursor = 'zoom-in'
        image.addEventListener('click', (event) => {
          event.preventDefault()
          openAt(position, image)
        })
      })
    }

    // ---- 工具栏按钮 ----
    root.querySelectorAll('[data-act]').forEach((el) => {
      el.addEventListener('click', (event) => {
        const act = (el as HTMLElement).dataset.act
        if (act === 'close') {
          event.stopPropagation()
          close()
        } else if (act === 'prev') go(-1)
        else if (act === 'next') go(1)
        else if (act === 'zoom-in') applyScale(scale * 1.6, 0, 0, true)
        else if (act === 'zoom-out') applyScale(scale / 1.6, 0, 0, true)
        else if (act === 'reset') {
          scale = MIN_SCALE
          x = 0
          y = 0
          render(true)
        }
      })
    })

    // ---- 滚轮缩放 ----
    stage.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault()
        const rect = stage.getBoundingClientRect()
        const originX = event.clientX - rect.left - rect.width / 2
        const originY = event.clientY - rect.top - rect.height / 2
        applyScale(scale * Math.exp(-event.deltaY * 0.0015), originX, originY)
      },
      { passive: false },
    )

    // ---- 指针手势：拖拽平移 / 双指缩放 / 左右滑动切换 ----
    stage.addEventListener('pointerdown', (event) => {
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY })
      if (pointers.size === 1) {
        dragging = true
        moved = false
        startX = event.clientX
        startY = event.clientY
        stage.setPointerCapture(event.pointerId)
        if (scale > MIN_SCALE) stage.classList.add('is-dragging')
      } else if (pointers.size === 2) {
        const [a, b] = [...pointers.values()]
        pinchStart = Math.hypot(a.x - b.x, a.y - b.y)
        pinchScale = scale
      }
    })

    stage.addEventListener('pointermove', (event) => {
      const pointer = pointers.get(event.pointerId)
      if (!pointer) return
      const dx = event.clientX - pointer.x
      const dy = event.clientY - pointer.y
      pointer.x = event.clientX
      pointer.y = event.clientY

      if (pointers.size >= 2) {
        const [a, b] = [...pointers.values()]
        const distance = Math.hypot(a.x - b.x, a.y - b.y)
        if (pinchStart > 0) applyScale((pinchScale * distance) / pinchStart)
        return
      }

      if (!dragging) return
      if (Math.abs(event.clientX - startX) > 4 || Math.abs(event.clientY - startY) > 4) moved = true
      if (scale > MIN_SCALE) {
        x += dx
        y += dy
        clampPan()
        render(false)
      }
    })

    const endPointer = (event: PointerEvent) => {
      const pointer = pointers.get(event.pointerId)
      pointers.delete(event.pointerId)
      if (pointers.size < 2) pinchStart = 0
      if (pointers.size > 0) return

      stage.classList.remove('is-dragging')
      if (dragging && scale === MIN_SCALE) {
        const dx = event.clientX - startX
        const dy = event.clientY - startY
        if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1)
      }
      dragging = false
      if (stage.hasPointerCapture?.(event.pointerId)) stage.releasePointerCapture(event.pointerId)
    }

    stage.addEventListener('pointerup', endPointer)
    stage.addEventListener('pointercancel', endPointer)

    // ---- 双击图片缩放 / 点击空白处关闭 ----
    const isInsideImage = (event: { clientX: number; clientY: number }) => {
      if (!img.clientWidth) return false
      const rect = img.getBoundingClientRect()
      return (
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom
      )
    }

    let lastTap = 0
    stage.addEventListener('pointerup', (event) => {
      if (pointers.size > 0 || moved || !isInsideImage(event)) return
      const now = Date.now()
      if (now - lastTap < 320) {
        lastTap = 0
        if (scale > MIN_SCALE) {
          scale = MIN_SCALE
          x = 0
          y = 0
          render(true)
        } else {
          applyScale(DOUBLE_TAP_SCALE, 0, 0, true)
        }
        return
      }
      lastTap = now
    })

    stage.addEventListener('click', (event) => {
      if (moved || pointers.size > 0 || isInsideImage(event)) return
      close()
    })

    // ---- 键盘 ----
    const onKey = (event: KeyboardEvent) => {
      if (!open) return
      switch (event.key) {
        case 'Escape': close(); break
        case 'ArrowLeft': go(-1); break
        case 'ArrowRight': go(1); break
        case '+':
        case '=': applyScale(scale * 1.6, 0, 0, true); break
        case '-':
        case '_': applyScale(scale / 1.6, 0, 0, true); break
        case '0': scale = MIN_SCALE; x = 0; y = 0; render(true); break
        default: return
      }
      event.preventDefault()
    }
    document.addEventListener('keydown', onKey)

    // ---- 视口变化时重新夹紧位移 ----
    const onResize = () => {
      if (open) {
        clampPan()
        render(false)
      }
    }
    window.addEventListener('resize', onResize)

    const cleanup = () => {
      document.removeEventListener('keydown', onKey)
      // resize 必须一起解绑：换页后是全新的 DOM，旧闭包会一直留在 window 上
      window.removeEventListener('resize', onResize)
      if (open) close()
      // 页面切换时不再等待关闭动画，立即还原滚动锁定
      restoreScroll()
    }
    document.addEventListener('astro:before-swap', cleanup, { once: true })

    bindImages()
  }

  initLightbox()
  document.addEventListener('astro:page-load', initLightbox)
</script>
