---
/**
 * ImageLightbox —— 自研图片灯箱（无第三方依赖，由 siteConfig.theme.PhotoSwipe 控制）
 * 缩放 50% - 800%（100% 为适应屏幕；桌面端基准 86%，移动端 100%）；只作用于 .markdown-content 的正文图片（链接内图片除外）。
 */
import { i18n } from 'astro:config/client';
import i18nit from '@i18n/translation';

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);
---

<div class="lightbox" id="momo-lightbox" role="dialog" aria-modal="true" aria-label={t("a11y.imageViewer")} hidden>
  <div class="lightbox-backdrop" data-act="close"></div>

  <div class="lightbox-stage" id="lb-stage">
    <img class="lightbox-img" id="lb-img" alt="" draggable="false" decoding="async" />
  </div>

  <button class="lightbox-nav lightbox-prev" data-act="prev" type="button" aria-label={t("a11y.previousImage")} title={`${t("a11y.previousImage")} (←)`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>
  <button class="lightbox-nav lightbox-next" data-act="next" type="button" aria-label={t("a11y.nextImage")} title={`${t("a11y.nextImage")} (→)`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </button>

  <div class="lightbox-bar">
    <span class="lightbox-counter" id="lb-counter">1 / 1</span>
    <span class="lightbox-spacer"></span>
    <button class="lightbox-btn" data-act="zoom-out" type="button" aria-label={t("a11y.zoomOut")} title={`${t("a11y.zoomOut")} (-)`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.2" y2="16.2"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
    </button>
    <span class="lightbox-zoom" id="lb-zoom">100%</span>
    <button class="lightbox-btn" data-act="zoom-in" type="button" aria-label={t("a11y.zoomIn")} title={`${t("a11y.zoomIn")} (+)`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.2" y2="16.2"></line><line x1="8" y1="11" x2="14" y2="11"></line><line x1="11" y1="8" x2="11" y2="14"></line></svg>
    </button>
    <button class="lightbox-btn" data-act="reset" type="button" aria-label={t("a11y.resetZoom")} title={`${t("a11y.resetZoom")} (0)`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9V5a2 2 0 0 1 2-2h4"></path><path d="M21 9V5a2 2 0 0 0-2-2h-4"></path><path d="M3 15v4a2 2 0 0 0 2 2h4"></path><path d="M21 15v4a2 2 0 0 1-2 2h-4"></path></svg>
    </button>
    <button class="lightbox-btn lightbox-close" data-act="close" type="button" aria-label={t("a11y.closeImage")} title={`${t("a11y.closeImage")} (Esc)`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <p class="lightbox-caption" id="lb-caption"></p>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    /* 必须高于 FabMenu（z-1000）与目录面板（z-1001），否则悬浮按钮会压在遮罩上 */
    z-index: var(--momo-z-lightbox);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    color: #fff;
    user-select: none;
  }

  .lightbox[hidden] { display: none; }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    cursor: zoom-out;
  }

  .lightbox-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }

  .lightbox-stage.is-zoomed { cursor: move; }
  .lightbox-stage.is-dragging { cursor: grabbing; }

  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    transform-origin: center center;
    will-change: transform;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .lightbox-stage.is-animating .lightbox-img {
    transition: transform var(--momo-t-fast) var(--momo-ease-out);
  }

  .lightbox-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  }

  .lightbox-spacer { flex: 1; }

  .lightbox-counter,
  .lightbox-zoom {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.85);
    min-width: 3.2em;
    text-align: center;
  }

  .lightbox-btn,
  .lightbox-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-radius: 8px;
    cursor: pointer;
    transition: background var(--momo-t-fast) var(--momo-ease-out), transform var(--momo-t-fast) var(--momo-ease-out);
  }

  .lightbox-btn { width: 34px; height: 34px; }
  .lightbox-btn:not([disabled]):hover,
  .lightbox-nav:not([disabled]):hover { background: rgba(255, 255, 255, 0.26); }

  .lightbox-btn[disabled] { opacity: 0.3; cursor: default; }

  .lightbox-btn svg { width: 18px; height: 18px; }
  .lightbox-nav svg { width: 26px; height: 26px; }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    width: 46px;
    height: 46px;
    transform: translateY(-50%);
    opacity: 0.65;
  }

  .lightbox-nav:not([disabled]):hover { opacity: 1; }
  .lightbox-prev { left: 16px; }
  .lightbox-next { right: 16px; }

  .lightbox-nav[disabled] { opacity: 0.18; cursor: default; }

  .lightbox-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 14px 18px;
    text-align: center;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
    pointer-events: none;
  }

  .lightbox-caption:empty { display: none; }

  @media (max-width: 776px) {
    .lightbox-nav { width: 38px; height: 38px; }
    .lightbox-prev { left: 8px; }
    .lightbox-next { right: 8px; }
    .lightbox-bar { padding: 8px 10px; }
  }
</style>

<script>
  import { registerPageInit } from '@utils/pageInit'
  import { lockPageScroll, unlockPageScroll } from '@utils/scrollLock'

  // 100% = 图片适应屏幕：缩小最多到 50%，放大最多到 800%；桌面端打开时默认 86%
  const DESKTOP_BASE_SCALE = 0.86
  const MIN_SCALE = 0.5
  const MAX_SCALE = 8
  const DOUBLE_TAP_SCALE = 2.5

  // 双指缩放：PINCH_DEAD_ZONE 内视为抖动、完全不缩放；PINCH_GAIN 是死区外的对数域阻尼（<1 更缓）；
  // PINCH_MIN_SPAN 是参与计算的最小起始间距，两指挨太近时按它归一化才不会「一碰就炸」
  const PINCH_DEAD_ZONE = 10
  const PINCH_GAIN = 0.8
  const PINCH_MIN_SPAN = 48
  // 左右滑动切图：只认单指、位移够远且明显偏水平的这一种手势
  const SWIPE_MIN_DISTANCE = 60
  const SWIPE_DOMINANCE = 1.2

  // 必须与样式的 @media (max-width: 776px) 对齐（777px 起算桌面端）
  const isMobileViewport = () => window.matchMedia('(max-width: 776px)').matches
  // 基准比例：打开 / 切图 / 双击复位 /「默认比例」按钮都回到它
  const baseScale = () => (isMobileViewport() ? 1 : DESKTOP_BASE_SCALE)

  interface LbItem { src: string; alt: string; caption: string }

  // 正文里可放大的图片（链接内图片除外）：按页面缓存一次，换页时失效
  let imagesCache: HTMLImageElement[] | null = null

  function contentImages(): HTMLImageElement[] {
    if (imagesCache) return imagesCache
    const container = document.querySelector('.markdown-content')
    if (!container) {
      imagesCache = []
      return imagesCache
    }
    imagesCache = Array.from(container.querySelectorAll('img')).filter(
      (img) => !img.closest('a') && !!(img.currentSrc || img.getAttribute('src')),
    )
    return imagesCache
  }

  function itemOf(img: HTMLImageElement): LbItem {
    const figure = img.closest('figure')
    return {
      src: img.currentSrc || img.getAttribute('src') || '',
      alt: img.getAttribute('alt') || '',
      // 拼图（image-collage）不输出 figcaption，图注改从图片自己的 title 上取
      caption:
        figure?.querySelector('figcaption')?.textContent?.trim() ||
        img.getAttribute('title')?.trim() ||
        '',
    }
  }

  function initLightbox() {
    imagesCache = null

    const root = document.getElementById('momo-lightbox') as HTMLElement | null
    if (!root || root.dataset.ready === '1') return
    root.dataset.ready = '1'

    const stage = root.querySelector('#lb-stage') as HTMLElement
    const img = root.querySelector('#lb-img') as HTMLImageElement
    const counter = root.querySelector('#lb-counter') as HTMLElement
    const zoomLabel = root.querySelector('#lb-zoom') as HTMLElement
    const caption = root.querySelector('#lb-caption') as HTMLElement
    const bar = root.querySelector('.lightbox-bar') as HTMLElement
    const zoomOutBtn = root.querySelector('[data-act="zoom-out"]') as HTMLButtonElement | null
    const zoomInBtn = root.querySelector('[data-act="zoom-in"]') as HTMLButtonElement | null
    const resetBtn = root.querySelector('[data-act="reset"]') as HTMLButtonElement | null

    let items: LbItem[] = []
    let index = 0
    let scale = baseScale()
    let x = 0
    let y = 0
    let open = false
    let lastFocus: HTMLElement | null = null
    let transitionSeq = 0
    const pointers = new Map<number, { x: number; y: number }>()
    let dragging = false
    let moved = false
    // 本次手势出现过第二根手指：这一轮只可能是缩放 / 平移，抬手时不切图、不算双击
    let pinched = false
    // 上一次单击的时间戳（双击判定）
    let lastTap = 0
    let startX = 0
    let startY = 0
    let pinchStart = 0
    let pinchScale = baseScale()

    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value))

    // 缩放是浮点乘除算出来的，判断「是否处于基准比例」必须留误差，否则按钮置灰 / 双击复位会失灵
    const SCALE_EPSILON = 0.001
    const atBase = () => Math.abs(scale - baseScale()) < SCALE_EPSILON

    function cancelAnimations(elements: Element[]) {
      elements.forEach((element) => {
        element.getAnimations().forEach((animation) => animation.cancel())
      })
    }

    // 锁页面滚动统一走 @utils/scrollLock：它锁 <html>（OverlayScrollbars 下的滚动容器），计数式。
    // ⚠️ 必须只在状态翻转时加减：cleanup() 里 close() 已解过一次，再解一次会打穿计数、误开并存的抽屉锁
    let scrollLocked = false

    function lockScroll() {
      if (scrollLocked) return
      scrollLocked = true
      lockPageScroll()
    }

    function restoreScroll() {
      if (!scrollLocked) return
      scrollLocked = false
      unlockPageScroll()
    }

    function clampPan() {
      const maxX = Math.max(0, (img.clientWidth * scale - stage.clientWidth) / 2)
      const maxY = Math.max(0, (img.clientHeight * scale - stage.clientHeight) / 2)
      x = clamp(x, -maxX, maxX)
      y = clamp(y, -maxY, maxY)
    }

    function render(animate = false) {
      stage.classList.toggle('is-animating', animate)
      // 只有大于基准比例时才有可平移内容，缩小状态光标保持默认
      stage.classList.toggle('is-zoomed', scale > baseScale() + SCALE_EPSILON)
      img.style.transform = transformOf()
      zoomLabel.textContent = `${Math.round(scale * 100)}%`
      syncZoomButtons()
      if (animate) {
        window.setTimeout(() => stage.classList.remove('is-animating'), 240)
      }
    }

    function syncZoomButtons() {
      if (zoomOutBtn) zoomOutBtn.disabled = scale <= MIN_SCALE
      if (zoomInBtn) zoomInBtn.disabled = scale >= MAX_SCALE
      if (resetBtn) resetBtn.disabled = atBase()
    }

    function applyScale(next: number, originX = 0, originY = 0, animate = false) {
      const clamped = clamp(next, MIN_SCALE, MAX_SCALE)
      if (clamped === scale) return
      // 以光标（或屏幕中心）为锚点缩放
      const ratio = clamped / scale
      x = originX - (originX - x) * ratio
      y = originY - (originY - y) * ratio
      scale = clamped
      // 缩到基准比例及以下时图片不会超出舞台，直接回到居中
      if (scale <= baseScale() + SCALE_EPSILON) {
        x = 0
        y = 0
      } else {
        clampPan()
      }
      render(animate)
    }

    // ---- 动画辅助 ----
    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches

    function transformOf() {
      return `translate3d(${x}px, ${y}px, 0) scale(${scale})`
    }

    // 缩略图 -> 灯箱位置的 FLIP transform（等比缩放 + 位移）
    function flipTransform(from: DOMRect, to: DOMRect) {
      const dx = from.left + from.width / 2 - (to.left + to.width / 2)
      const dy = from.top + from.height / 2 - (to.top + to.height / 2)
      const ratio = Math.min(from.width / to.width, from.height / to.height)
      return `translate3d(${dx}px, ${dy}px, 0) scale(${clamp(ratio, 0.05, 8)})`
    }

    // 起止必须用「未缩放、未平移」的原始框：getBoundingClientRect() 含当前 scale 与位移。
    // 变换以中心为原点，故 原始尺寸 = 渲染尺寸 / scale，原始中心 = 渲染中心 - 位移
    function baseRect(): DOMRect {
      const rect = img.getBoundingClientRect()
      const width = rect.width / scale
      const height = rect.height / scale
      return new DOMRect(
        rect.left + (rect.width - width) / 2 - x,
        rect.top + (rect.height - height) / 2 - y,
        width,
        height,
      )
    }

    // 飞回目标是当前 index 对应的缩略图（items 与 contentImages() 顺序一一对应），不能固定用打开时那张
    function currentThumb(): HTMLImageElement | null {
      const thumb = contentImages()[index]
      return thumb && thumb.isConnected ? thumb : null
    }

    // 飞回目标框：⚠️ 缩略图滚出视口时不能返回 null（调用方会退化成「立刻隐藏」、直接闪退），
    // 而是把中心夹回视口内再算 FLIP，方向仍朝向缩略图那一侧、位移限制在一屏内
    function sourceRect(): DOMRect | null {
      const source = currentThumb()
      if (!source) return null
      const rect = source.getBoundingClientRect()
      // 量不出尺寸（图片还没解码 / 被隐藏）时不兜底：没有目标尺寸就算不出缩放比例
      if (rect.width < 8 || rect.height < 8) return null
      const centerX = rect.left + rect.width / 2
      const centerY = rect.top + rect.height / 2
      const margin = 12
      const clampedX = clamp(centerX, margin, Math.max(margin, window.innerWidth - margin))
      const clampedY = clamp(centerY, margin, Math.max(margin, window.innerHeight - margin))
      if (clampedX === centerX && clampedY === centerY) return rect
      return new DOMRect(
        clampedX - rect.width / 2,
        clampedY - rect.height / 2,
        rect.width,
        rect.height,
      )
    }

    function waitForImage() {
      if (img.complete && img.naturalWidth) return Promise.resolve()
      return new Promise<void>((resolve) => {
        const done = () => {
          img.removeEventListener('load', done)
          img.removeEventListener('error', done)
          resolve()
        }
        img.addEventListener('load', done, { once: true })
        img.addEventListener('error', done, { once: true })
      })
    }

    function preloadNeighbours() {
      for (const offset of [1, -1]) {
        const neighbour = items[(index + offset + items.length) % items.length]
        if (neighbour && neighbour.src !== img.getAttribute('src')) {
          const preload = new Image()
          preload.src = neighbour.src
        }
      }
    }

    function applyImage(item: LbItem) {
      scale = baseScale()
      x = 0
      y = 0
      // 新图先设为透明，等飞入 / 淡入动画驱动 opacity，避免未解码时闪现在最终位置
      img.style.opacity = '0'
      img.src = item.src
      img.alt = item.alt
      counter.textContent = `${index + 1} / ${items.length}`
      caption.textContent = item.caption || item.alt || ''
      render(false)
    }

    // 打开：从缩略图飞入；飞回目标由 currentThumb() 按当时的 index 现取
    async function openAt(position: number, source: HTMLImageElement) {
      items = contentImages().map(itemOf)
      if (!items.length) return
      lastFocus = document.activeElement as HTMLElement | null
      open = true
      const seq = ++transitionSeq

      const thumbRect = source.getBoundingClientRect()
      index = clamp(position, 0, items.length - 1)
      applyImage(items[index])
      root.hidden = false
      root.setAttribute('aria-hidden', 'false')
      root.style.opacity = ''
      lockScroll()
      syncNav()
      preloadNeighbours()

      cancelAnimations([img, root, bar, caption])
      await waitForImage()
      if (!open || seq !== transitionSeq) return
      playOpenAnimation(thumbRect)
      // preventScroll：焦点滚进视口会顶走已锁定滚动的页面，缩略图可能因此滑出视口
      ;(root.querySelector('.lightbox-close') as HTMLElement)?.focus({ preventScroll: true })
    }

    function playOpenAnimation(thumbRect: DOMRect | null) {
      const reduced = reducedMotion()
      // 清掉上一次快速开关残留的动画（尤其是 fill: backwards 的工具栏动画）
      cancelAnimations([img, root, bar, caption])
      // 交回给动画驱动 opacity；没有动画时（reduced / 未知尺寸）要当场显示新图
      img.style.opacity = ''
      const to = baseRect()
      const duration = reduced || !to.width ? 0 : 380

      if (duration && thumbRect) {
        img.animate(
          [
            { transform: flipTransform(thumbRect, to), opacity: 0.65 },
            { transform: transformOf(), opacity: 1 },
          ],
          // 放大不回弹：过冲会让图片先冲过头再缩回来
          { duration, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' },
        )
      }
      root.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: reduced ? 0 : 220,
        easing: 'ease-out',
      })
      bar.animate(
        [
          { opacity: 0, transform: 'translateY(-10px)' },
          { opacity: 1, transform: 'none' },
        ],
        { duration: reduced ? 0 : 260, delay: reduced ? 0 : 90, easing: 'ease-out', fill: 'backwards' },
      )
      caption.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: reduced ? 0 : 260,
        delay: reduced ? 0 : 120,
        easing: 'ease-out',
        fill: 'backwards',
      })
    }

    // 关闭：整层淡出 + 图片飞回缩略图
    // ⚠️ 动画必须 fill: 'forwards'，且等它真正结束后才隐藏 / 还原滚动，否则会闪一帧全黑遮罩
    function close() {
      if (!open) return
      open = false
      const seq = ++transitionSeq
      pointers.clear()
      dragging = false

      const reduced = reducedMotion()
      const thumbRect = sourceRect()
      const animations: Animation[] = []
      const finish = () => {
        // 关闭动画期间又被重新打开（动画被取消也会让 finished 结束），此时不要隐藏
        if (seq !== transitionSeq) return
        // ⚠️ 先隐藏再取消动画：取消 fill 效果时页面已完成隐藏，不会回弹闪烁
        root.hidden = true
        root.setAttribute('aria-hidden', 'true')
        root.style.opacity = ''
        img.removeAttribute('src')
        animations.forEach((animation) => animation.cancel())
        restoreScroll()
        // preventScroll：避免关闭时浏览器把焦点元素滚回视口导致页面跳动
        lastFocus?.focus?.({ preventScroll: true })
      }

      cancelAnimations([img, root, bar, caption])

      if (reduced || !thumbRect || !img.clientWidth) {
        finish()
        return
      }

      // 起点是当前画面（含放大 / 平移），终点用原始框算，飞回缩略图才精确
      const natural = baseRect()
      const duration = 260
      animations.push(
        img.animate(
          [
            { transform: transformOf(), opacity: 1 },
            { transform: flipTransform(thumbRect, natural), opacity: 0.35 },
          ],
          { duration, easing: 'cubic-bezier(0.32, 0.72, 0, 1)', fill: 'forwards' },
        ),
        root.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration,
          easing: 'ease-in',
          fill: 'forwards',
        }),
      )
      // 两个动画时长一致，等全部结束再隐藏；元素被移除时动画被取消，allSettled 同样兜底
      Promise.allSettled(animations.map((animation) => animation.finished)).then(finish)
    }

    // 前后切换：旧图滑出、新图滑入
    async function go(delta: number) {
      if (items.length < 2) return
      const seq = ++transitionSeq
      const next = (index + delta + items.length) % items.length
      const reduced = reducedMotion()
      // ⚠️ 不能先把 scale / x / y 复位：第一帧 transformOf() 会突跳，复位统一交给 applyImage
      const outScale = scale * 0.97

      if (!reduced) {
        await img
          .animate(
            [
              { transform: transformOf(), opacity: 1 },
              { transform: `translate3d(${x - delta * 44}px, ${y}px, 0) scale(${outScale})`, opacity: 0 },
            ],
            { duration: 150, easing: 'ease-in' },
          )
          .finished.catch(() => {})
        if (seq !== transitionSeq || !open) return
      }

      // 换图：applyImage 复位缩放 / 平移，新图从基准比例滑入
      index = next
      applyImage(items[index])
      await waitForImage()
      if (seq !== transitionSeq || !open) return
      preloadNeighbours()
      img.style.opacity = ''

      if (!reduced) {
        img.animate(
          [
            { transform: `translate3d(${delta * 44}px, 0, 0) scale(${scale * 0.97})`, opacity: 0 },
            { transform: transformOf(), opacity: 1 },
          ],
          { duration: 230, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' },
        )
      }
    }

    function syncNav() {
      const single = items.length <= 1
      root.querySelectorAll('.lightbox-nav').forEach((el) => {
        ;(el as HTMLButtonElement).disabled = single
      })
    }

    // ---- 打开：点击正文图片 ----
    function bindImages() {
      contentImages().forEach((image, position) => {
        if (image.dataset.lbBound === '1') return
        image.dataset.lbBound = '1'
        image.style.cursor = 'zoom-in'
        image.addEventListener('click', (event) => {
          event.preventDefault()
          openAt(position, image)
        })
      })
    }

    // ---- 工具栏按钮 ----
    root.querySelectorAll('[data-act]').forEach((el) => {
      el.addEventListener('click', (event) => {
        const act = (el as HTMLElement).dataset.act
        if (act === 'close') {
          event.stopPropagation()
          close()
        } else if (act === 'prev') go(-1)
        else if (act === 'next') go(1)
        else if (act === 'zoom-in') applyScale(scale * 1.6, 0, 0, true)
        else if (act === 'zoom-out') applyScale(scale / 1.6, 0, 0, true)
        else if (act === 'reset') {
          scale = baseScale()
          x = 0
          y = 0
          render(true)
        }
      })
    })

    // ---- 滚轮缩放 ----
    stage.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault()
        const rect = stage.getBoundingClientRect()
        const originX = event.clientX - rect.left - rect.width / 2
        const originY = event.clientY - rect.top - rect.height / 2
        applyScale(scale * Math.exp(-event.deltaY * 0.0015), originX, originY)
      },
      { passive: false },
    )

    // ---- 指针手势：拖拽平移 / 双指缩放 / 左右滑动切换 ----
    // 双指缩放目标比例：扣掉死区后在对数域阻尼；用相对起始值的绝对值，越界后往回捏不会空转
    function pinchScaleOf(distance: number) {
      if (!pinchStart) return pinchScale
      // 起始间距过近时按 PINCH_MIN_SPAN 归一化
      const span = Math.max(pinchStart, PINCH_MIN_SPAN)
      const delta = distance - pinchStart
      if (Math.abs(delta) <= PINCH_DEAD_ZONE) return pinchScale
      const effective = span + delta - Math.sign(delta) * PINCH_DEAD_ZONE
      return pinchScale * Math.pow(Math.max(effective, 1) / span, PINCH_GAIN)
    }

    // 重新以当前双指间距为基准开始缩放（第二根手指按下 / 三指回落到两指时）
    function beginPinch() {
      const [a, b] = [...pointers.values()]
      if (!a || !b) return
      pinchStart = Math.hypot(a.x - b.x, a.y - b.y)
      pinchScale = scale
    }

    stage.addEventListener('pointerdown', (event) => {
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY })
      if (pointers.size >= 2) {
        // ⚠️ 第二根手指一落下，这一轮手势就定死为缩放：越位切图、双击复位、点击空白关闭全部作废
        pinched = true
        moved = true
        dragging = false
        lastTap = 0
        stage.classList.remove('is-dragging')
        if (pointers.size === 2) beginPinch()
        return
      }
      pinched = false
      dragging = true
      moved = false
      startX = event.clientX
      startY = event.clientY
      stage.setPointerCapture(event.pointerId)
      if (scale > baseScale() + SCALE_EPSILON) stage.classList.add('is-dragging')
    })

    stage.addEventListener('pointermove', (event) => {
      const pointer = pointers.get(event.pointerId)
      if (!pointer) return
      const dx = event.clientX - pointer.x
      const dy = event.clientY - pointer.y
      pointer.x = event.clientX
      pointer.y = event.clientY

      if (pointers.size >= 2) {
        if (!pinchStart) return
        const [a, b] = [...pointers.values()]
        applyScale(pinchScaleOf(Math.hypot(a.x - b.x, a.y - b.y)))
        return
      }

      if (!dragging) return
      if (Math.abs(event.clientX - startX) > 4 || Math.abs(event.clientY - startY) > 4) moved = true
      if (scale > baseScale() + SCALE_EPSILON) {
        x += dx
        y += dy
        clampPan()
        render(false)
      }
    })

    const endPointer = (event: PointerEvent, cancelled = false) => {
      pointers.delete(event.pointerId)
      if (pointers.size === 2) beginPinch()
      else if (pointers.size < 2) pinchStart = 0
      if (pointers.size > 0) return

      stage.classList.remove('is-dragging')
      // 未放大时左右滑动切图，但必须「从按下到抬起始终单指」：pinched 一旦置位就只认缩放；
      // cancelled（系统手势抢走指针）时坐标不可信，一律不算
      if (!cancelled && dragging && !pinched && scale <= baseScale() + SCALE_EPSILON) {
        const dx = event.clientX - startX
        const dy = event.clientY - startY
        if (
          Math.abs(dx) > SWIPE_MIN_DISTANCE &&
          Math.abs(dx) > Math.abs(dy) * SWIPE_DOMINANCE
        ) {
          go(dx < 0 ? 1 : -1)
        }
      }
      dragging = false
      if (stage.hasPointerCapture?.(event.pointerId)) stage.releasePointerCapture(event.pointerId)
    }

    stage.addEventListener('pointerup', (event) => endPointer(event))
    stage.addEventListener('pointercancel', (event) => endPointer(event, true))

    // ---- 双击图片缩放 / 点击空白处关闭 ----
    const isInsideImage = (event: { clientX: number; clientY: number }) => {
      if (!img.clientWidth) return false
      const rect = img.getBoundingClientRect()
      return (
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom
      )
    }

    stage.addEventListener('pointerup', (event) => {
      // pinched：双指缩放结束的抬手不算单击，否则会被读成双击
      if (pointers.size > 0 || pinched || moved || !isInsideImage(event)) return
      const now = Date.now()
      if (now - lastTap < 320) {
        lastTap = 0
        if (!atBase()) {
          scale = baseScale()
          x = 0
          y = 0
          render(true)
        } else {
          applyScale(DOUBLE_TAP_SCALE, 0, 0, true)
        }
        return
      }
      lastTap = now
    })

    stage.addEventListener('click', (event) => {
      if (moved || pointers.size > 0 || isInsideImage(event)) return
      close()
    })

    // ---- 键盘 ----
    const onKey = (event: KeyboardEvent) => {
      if (!open) return
      switch (event.key) {
        case 'Escape': close(); break
        case 'ArrowLeft': go(-1); break
        case 'ArrowRight': go(1); break
        case '+':
        case '=': applyScale(scale * 1.6, 0, 0, true); break
        case '-':
        case '_': applyScale(scale / 1.6, 0, 0, true); break
        case '0': scale = baseScale(); x = 0; y = 0; render(true); break
        default: return
      }
      event.preventDefault()
    }
    document.addEventListener('keydown', onKey)

    // ---- 视口变化时重新夹紧位移 ----
    const onResize = () => {
      if (open) {
        clampPan()
        render(false)
      }
    }
    window.addEventListener('resize', onResize)

    const cleanup = () => {
      document.removeEventListener('keydown', onKey)
      // resize 必须一起解绑：换页后是全新的 DOM，旧闭包会一直留在 window 上
      window.removeEventListener('resize', onResize)
      if (open) close()
      // 换页时不等待关闭动画，立即还原滚动锁定
      restoreScroll()
    }
    // 换页时先拆掉旧灯箱：@swup/astro 把 content:replace 映射成 astro:before-swap，
    // once 保证同一个实例只清理一次（initLightbox 再次执行会重新注册）
    document.addEventListener('astro:before-swap', cleanup, { once: true })

    bindImages()
  }

  // 首屏 + 每次换页都要重新绑定：灯箱 DOM 在替换容器内、每页都是新的
  registerPageInit(initLightbox)
</script>
