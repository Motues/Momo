---
// ImageModule 对应的 CSS 需要设置为 is::global 才能被正确应用

import { siteConfig } from '@/config';
import { Image } from "astro:assets";
import path from "path"
import { getLqipGradient } from "@utils/getLqipColors";

interface Props {
    src: string;
    alt?: string;
    id?: string;
    class?: string;
    width?: number;
    height?: number;
    /** 首屏关键图片（文章封面 / 首张卡片封面）：eager + 高优先级，避免被 lazy 拖成 LCP */
    priority?: boolean;
    /**
     * 响应式宽度档位（只对 src/ 下的本地图片生效）。
     * 不传就退化成「一张原图」——卡片封面 1920px 原图有 400 KB，而实际显示宽度不到 776px。
     */
    widths?: number[];
    /** 配合 widths 的 sizes，决定浏览器挑哪一档 */
    sizes?: string;
    /** 输出质量，默认交给 Astro/sharp */
    quality?: number;
}

const { src, alt, id, width, height, priority = false, widths, sizes, quality } = Astro.props;
const className = Astro.props.class;

// 非首屏图片保持 lazy（Astro 的 <Image> 默认就是 lazy）
const loadingAttrs = priority
    ? { loading: 'eager' as const, fetchpriority: 'high' as const, decoding: 'async' as const }
    : { loading: 'lazy' as const, decoding: 'async' as const };

const isLocal = !(
    src.startsWith("/") ||
    src.startsWith("http")
);
const isPublic = src.startsWith("/");

let imageLoad;
let lqipGradient = "";
const enableLQIP = siteConfig.theme.LQIP;

if (isLocal) {
  // 只收集图片文件！早先这里的 pattern 是 "../../**/*"，会把 src 下的所有文件
  // （包括 Markdown.astro、markdown.css 等）都变成动态 import，
  // 结果任何用到 ImageModule 的页面（例如首页）都会被拖上几百 KB 的正文样式。
  //
  // caseSensitive: false 只影响 glob 的“发现”阶段：Vite 默认大小写敏感，
  // 相机导出的 .JPG / .PNG 这类大写后缀会整个漏掉，封面直接变成 undefined。
  const images = import.meta.glob<ImageMetadata>(
    "../../**/*.{jpg,jpeg,jfif,png,apng,webp,avif,gif,svg,tiff,tif,bmp,ico,heic}",
    { import: "default", caseSensitive: false }
  );

  // 查找仍然严格区分大小写：glob 的 key 用的是磁盘上的真实文件名，
  // 所以 cover.jpg 与 COVER.JPG 是两个不同文件，frontmatter 写哪个就取哪个，
  // 大小写写错依旧会报「Image file not found」，不会静默拿到另一个文件。
  const imagePath = path.normalize(path.join("../../", "/", src)).replace(/\\/g, "/");
  const imageGetter = images[imagePath];

  if (!imageGetter) {
    console.error(`\n[ERROR] Image file not found: ${imagePath}`);
  } else {
    imageLoad = await imageGetter();
    // 使用封装好的函数
    if(enableLQIP) lqipGradient = await getLqipGradient(imageLoad.fsPath);
  }
}

// 响应式档位：超过原图宽度的档位要去掉（sharp 的 withoutEnlargement 不会放大，
// 留着只会生成一个「标称 1080w、实际 811px」的错误描述符）；
// 过滤后一个不剩（原图本来就很小）就退回单张，不要传空数组给 <Image>
const filteredWidths =
  widths && imageLoad ? widths.filter((w) => w <= imageLoad.width) : widths;
const safeWidths = filteredWidths && filteredWidths.length > 0 ? filteredWidths : undefined;
---
<div 
  class:list={["image-wrapper", className]} 
  style={{ "--lqip": lqipGradient }}
  data-lqip-enabled={enableLQIP}
>
    <div class="lqip-bg"></div>
    {
        isLocal && imageLoad && (
        <Image 
            src={imageLoad} 
            alt={alt || ""} 
            id={id} 
            width={width} 
            height={height}
            widths={safeWidths}
            sizes={sizes}
            quality={quality}
            class=""
            {...loadingAttrs}
            onload="this.parentElement.dataset.loaded = 'true'" 
        />
        )
    }
  
    {
        !isLocal && (
        <img 
            src={src} 
            alt={alt || ""} 
            id={id} 
            width={width} 
            height={height} 
            {...loadingAttrs}
            class=""
            onload="this.parentElement.dataset.loaded = 'true'" 
        />
        )
    }
</div>

<style>
.image-wrapper {
    position: relative;
    overflow: hidden;
    background-color: transparent;
    display: block;
}

.lqip-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--lqip);
    z-index: 0;
    transition: opacity 0.8s ease;
    /* 这里原本还有 filter: blur(40px) 与 transform: scale(1.2)：
       --lqip 本身就是多条 radial-gradient（过渡是平滑的），再叠 40px 模糊观感几乎无差别，
       代价却是每张卡片常驻一个全尺寸模糊合成层（首页 6 张 = 6 个），滚动时纯属白烧填充率。
       正文图片的 .lqip-markdown-img（markdown.css）本来就没有 blur，这里与它对齐。 */
}

.image-wrapper img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
}

/* 图片加载完成后 */
.image-wrapper[data-loaded="true"] img {
    opacity: 1;
}

.image-wrapper[data-loaded="true"][data-lqip-enabled="true"] .lqip-bg {
    opacity: 0; /* 加载完后隐藏背景层 */
    /* 淡出结束后真正移出合成树：visibility 延迟 0.8s 再翻，不打断上面的淡出 */
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0s 0.8s;
}

.image-wrapper[data-lqip-enabled="false"] .lqip-bg {
    display: none; /* 禁用 LQIP 时不显示模糊背景 */
}

.image-wrapper[data-lqip-enabled="false"] img {
    opacity: 1; /* 禁用 LQIP 时直接显示图片 */
}
</style>