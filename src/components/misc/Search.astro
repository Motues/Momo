---
import type { SearchResult } from "@/global"
import { baseUrl } from "@utils/urlUtils";
import { getEntry, render } from 'astro:content'
import { i18n } from "astro:config/client";
import i18nit from "@i18n/translation";



const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const translations = {
  placeholder: t("search.placeholder"),
  error: t("search.error"),
  noresult: t("search.noresult")
};

const fakeResult: SearchResult[] = [
	{
		url: baseUrl("/"),
		meta: {
			title: "This Is a Fake Search Result",
		},
		excerpt:
			"Because the search cannot work in the <mark>dev</mark> environment.",
	},
	{
		url: baseUrl("/"),
		meta: {
			title: "If You Want to Test the Search",
		},
		excerpt: "Try running <mark>pnpm build && pnpm preview</mark> instead.",
  }
]
---
<!--
  层级：z-[1100] 必须高于右下角 FabMenu（#fabMenu 为 z-[1000]，其目录面板 z-[1001]
  是在 FAB 自己的层叠上下文里，所以盖过 1000 即可），否则遮罩与弹窗会压在 FAB 下面，
  浮动按钮会浮在遮罩之上；同时保持在图片灯箱（z-2000）之下。
-->
<div id="search-modal" class="fixed inset-0 z-[1100] opacity-0 pointer-events-none">
  <div class="absolute inset-0 modal-backdrop opacity-0" aria-hidden="true"></div>

  <div class="fixed inset-0 flex items-start justify-center p-4 pt-[25vh]">
    <div class="search-modal-content bg-[var(--bg-color)] rounded-xl shadow-xl w-full max-w-2xl border border-[var(--button-border-color)] overflow-hidden scale-80 transition duration-300 opacity-0 flex flex-col max-h-[40vh]">
      <div class="flex items-center p-4 border-b border-[var(--button-border-color)]">
        <svg class="w-5 h-5 text-[var(--text-color-70)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          type="text" 
          id="search-input"
          placeholder={t("search.placeholder")+"..."}
          class="w-full bg-transparent border-0 focus:ring-0 focus:outline-none  text-[var(--text-color)]"
        />
        <button id="close-search" class="ml-2 p-2 text-[var(--text-color-70)] rounded-lg hover:bg-[var(--button-hover-color)] active:bg-[var(--button-hover-color)]" aria-label="Close Search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="search-results" class="overflow-y-auto flex-grow">
        <div class="p-8 text-center text-[var(--text-color-70)]">
          <p>{t("search.placeholder")}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function initSearchModal() {
  const searchButton = document.getElementById('search-button');
  const searchModal = document.getElementById('search-modal');
  const closeSearch = document.getElementById('close-search');
  const searchInput = document.getElementById('search-input');
  const modalBackdrop = searchModal?.firstElementChild;
  const modalContent = searchModal?.querySelector('.search-modal-content');

  if (!searchButton || !searchModal) return;

  // 换页时本脚本会重新执行：先解绑上一次挂在 document 上的 keydown
  window.__momoSearchModal?.cleanup?.();

  const openModal = () => {
    searchModal.classList.remove('opacity-0', 'pointer-events-none');
    searchModal.offsetHeight;
    requestAnimationFrame(() => {
      modalBackdrop?.classList.remove('opacity-0');
      modalBackdrop?.classList.add('show');
      modalContent?.classList.remove('scale-80', 'opacity-0');
      modalContent?.classList.add('scale-100');
    });
    setTimeout(() => searchInput?.focus(), 300);
  };

  const closeModal = () => {
    requestAnimationFrame(() => {
      modalBackdrop?.classList.add('opacity-0');
      modalBackdrop?.classList.remove('show');
      modalContent?.classList.add('scale-80', 'opacity-0');
      modalContent?.classList.remove('scale-100');
    });
    setTimeout(() => {
      searchModal.classList.add('opacity-0', 'pointer-events-none');
    }, 300);
  };

  // 搜索按钮位于 transition:persist 的顶栏里，用 onclick 赋值保证幂等
  searchButton.onclick = openModal;
  if (closeSearch) closeSearch.onclick = closeModal;
  searchModal.onclick = (e) => {
    if (!modalContent?.contains(e.target)) closeModal();
  };

  const onKeyDown = (e) => {
    if (e.key === 'Escape' && !searchModal.classList.contains('opacity-0')) {
      closeModal();
    }
  };
  document.addEventListener('keydown', onKeyDown);

  window.__momoSearchModal = {
    cleanup() {
      document.removeEventListener('keydown', onKeyDown);
    },
  };
}

// astro:page-load 首次加载时也会触发，不再额外监听 DOMContentLoaded（避免首屏绑两份）
document.addEventListener('astro:page-load', initSearchModal);
</script>


<style>
  /* 遮罩只动画 opacity：backdrop-filter 逐帧插值会持续触发合成与重绘，
     模糊值固定为 2px（与原动画的终值一致），观感基本不变 */
  @keyframes backdropFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes backdropFadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  
  .modal-backdrop {
    background-color: rgba(0, 0, 0, 0.3);
    /* 注意：构建时的 CSS 压缩器会把 backdrop-filter 与 -webkit-backdrop-filter
       当作同一属性合并、只保留后写的那条，所以标准属性必须单独放进 @supports。 */
    -webkit-backdrop-filter: blur(2px);
    transition: opacity 0.3s ease-out;
  }

  @supports (backdrop-filter: blur(1px)) {
    .modal-backdrop {
      backdrop-filter: blur(2px);
    }
  }
  
  .modal-backdrop.show {
    animation: backdropFadeIn 0.3s ease-out forwards;
  }
  
  .modal-backdrop:not(.show) {
    animation: backdropFadeOut 0.3s ease-out forwards;
  }
  
  #search-input::-webkit-input-placeholder {
    color: var(--text-color-70);
  }
  
  #search-input::-moz-placeholder {
    color: var(--text-color-70);
  }
</style>

<script define:vars={{ fakeResult, translations }}>
function initPagefindSearch() {
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  
  if (!searchInput || !searchResults) return;

  // 避免重复绑定
  if (searchInput.dataset.bound === 'true') return;
  searchInput.dataset.bound = 'true';

  let searchTimeout;

  searchInput.addEventListener('input', (e) => {
    const query = e.target.value.trim();
    clearTimeout(searchTimeout);
    
    searchTimeout = setTimeout(() => {
      if (query.length > 0) {
        performSearch(query);
      } else {
        // 清空或显示默认状态
        searchResults.innerHTML = `
          <div class="p-8 text-center text-[var(--text-color-70)]">
            <p>${translations.placeholder}</p>
          </div>
        `;
      }
    }, 300);
  });
}

// 等待 Pagefind 就绪：Header 里的加载器会派发 pagefind-ready 事件
// （原实现监听的是 pagefindready，名字对不上，所以永远等不到通知）
function waitForPagefind(timeout = 4000) {
  if (window.pagefind) return Promise.resolve(window.pagefind);
  return new Promise((resolve) => {
    const done = () => {
      document.removeEventListener('pagefind-ready', done);
      resolve(window.pagefind ?? null);
    };
    document.addEventListener('pagefind-ready', done, { once: true });
    setTimeout(done, timeout);
  });
}

async function performSearch(query) {
  const searchResults = document.getElementById('search-results');
  const pagefind = window.pagefind ?? (await waitForPagefind());

  // 开发环境（或索引未加载成功）时退回假数据
  const isDev = !pagefind;

  if (isDev) {
    displayResults(fakeResult);
  } else {
    // 只需要初始化一次：重复调用 search() 即可，不必每次 destroy + init
    try {
      const searchResultsData = await pagefind.search(query);

      // 并发取回每条结果的数据（原来是逐条 await，串行等待）
      const results = (await Promise.all(
        searchResultsData.results.map(async (result) => {
          const data = await result.data();
          return {
            url: data.url,
            meta: { title: data.meta.title },
            excerpt: data.excerpt
          };
        })
      ));

      displayResults(results);
    } catch (error) {
      console.error('Search failed:', error);
      searchResults.innerHTML = `
        <div class="p-8 text-center text-red-500">
          <p>${translations.error}</p>
        </div>
      `;
    }
  }
}

function displayResults(results) {
  const searchResults = document.getElementById('search-results');
  if (!searchResults) return;

  if (results.length === 0) {
    searchResults.innerHTML = `
      <div class="p-8 text-center text-[var(--text-color-70)]">
        <p>${translations.noresult}</p>
      </div>
    `;
    return;
  }

  searchResults.innerHTML = results.map(result => `
    <div class="p-4 border-b border-[var(--button-border-color)] hover:bg-[var(--button-hover-color)]">
      <a href="${result.url}" class="block no-underline">
        <h3 class="text-lg font-semibold text-[var(--text-color)] mb-2">${result.meta.title}</h3>
        <p class="text-[var(--text-color-70)] text-sm">${result.excerpt}</p>
      </a>
    </div>
  `).join('');
}

// ========== 初始化逻辑 ==========
document.addEventListener('pagefind-ready', () => {
  // console.log('Pagefind is ready');
});
document.addEventListener('pagefindloaderror', () => {
  console.log('Pagefind failed to load, search functionality will not work');
});

// astro:page-load 首次加载时同样会触发，无需再监听 DOMContentLoaded
document.addEventListener('astro:page-load', initPagefindSearch);
</script>


<style is:global>
mark {
  background-color: #ffeb3b00;
  color: var(--link-color);
  padding: 0 2px;
  font-weight: 600;
}
</style>