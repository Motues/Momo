---
import { i18n } from "astro:config/client";
import i18nit from "@i18n/translation";

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

// 搜索弹窗在 swup 容器之外，不会随换页重建：把**每种语言**的文案一起渲染进 data 属性，
// 由脚本里的 syncSearchLocale() 在每次换页后按当前地址（语言）挑出该用的那一份。
const localeCodes: string[] = (i18n?.locales ?? [currentLang]).map((l) =>
  typeof l === 'string' ? l : l.path,
);
const translationsByLocale = Object.fromEntries(
  localeCodes.map((code) => {
    const tr = i18nit(code);
    return [
      code,
      {
        placeholder: tr("search.placeholder"),
        noresult: tr("search.noresult"),
        error: tr("search.error"),
        label: tr("search.label"),
        hint: tr("search.hint"),
        searching: tr("search.searching"),
        // t() 在没传参数时会把 {count} 原样替换成 "count"，这里先把它保住，
        // 真正填数字交给运行期的 updateCount()
        results: tr("search.results", { count: "{count}" }),
        tip: tr("search.tip"),
        devHint: tr("search.devHint"),
        page: tr("search.page"),
      },
    ];
  }),
);
---
<!--
  层级：z-[var(--momo-z-modal)] 必须高于右下角 FabMenu（#fabMenu 为 z-[1000]，其目录面板 z-[1001]
  是在 FAB 自己的层叠上下文里，所以盖过 1000 即可），否则遮罩与弹窗会压在 FAB 下面，
  浮动按钮会浮在遮罩之上；同时保持在图片灯箱（z-2000）之下。
-->
<div
  id="search-modal"
  role="dialog"
  aria-modal="true"
  aria-label={t("search.label")}
  data-i18n-search={JSON.stringify(translationsByLocale)}
  class="fixed inset-0 z-[var(--momo-z-modal)] opacity-0 pointer-events-none"
>
  <div class="absolute inset-0 modal-backdrop opacity-0" aria-hidden="true"></div>

  <div class="fixed inset-0 flex items-start justify-center p-4 pt-[25vh]">
    <div class="search-modal-content momo-panel w-full max-w-2xl overflow-hidden scale-90 opacity-0 flex flex-col max-h-[60vh]">
      <div class="flex items-center p-4 border-b border-[var(--button-border-color)]">
        <svg class="w-5 h-5 text-[var(--text-color-70)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          id="search-input"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-results-list"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          placeholder={t("search.placeholder")+"..."}
          class="w-full bg-transparent border-0 focus:ring-0 focus:outline-none text-[var(--text-color)]"
        />
        <button id="close-search" class="ml-2 momo-btn momo-btn--ghost momo-icon-btn" aria-label="Close Search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <!-- #search-results 是滚动容器（由 OverlayScrollbars 接管），
           #search-results-list 才是真正被重写的目标。
           ⚠️ 两者必须分开：OS 会在容器里插入自己的包装层
           （data-overlayscrollbars-padding / -content），重写容器的 innerHTML 会把
           这些包装层一起冲掉，实例当场失效。只换 list 的子节点，OS 的结构完好。 -->
      <div id="search-results" class="overflow-y-auto flex-grow">
        <div id="search-results-list" role="listbox" aria-label={t("search.label")}>
          <!-- data-search-hint：还停留在「默认提示」状态时，换页/换语言后要按当前语言改文案 -->
          <div class="p-8 text-center text-[var(--text-color-70)]" data-search-hint>
            <p>{t("search.hint")}</p>
          </div>
        </div>
      </div>
      <div class="search-footer">
        <span class="search-footer-count" data-search-count aria-live="polite"></span>
        <span class="search-footer-tip" data-search-tip>{t("search.tip")}</span>
      </div>
    </div>
  </div>
</div>

<script>
import { registerPageInit } from '@utils/pageInit';
import { currentLangFromUrl } from '@utils/locale';
import { lockPageScroll, unlockPageScroll } from '@utils/scrollLock';
import { loadSearchIndex, SearchIndexError } from '@utils/search/load';
import { search } from '@utils/search/rank';
import type { PreparedIndex } from '@utils/search/rank';
import type { SearchHit } from '@/types/search';

interface SearchTranslations {
  placeholder: string;
  noresult: string;
  error: string;
  label: string;
  hint: string;
  searching: string;
  results: string;
  tip: string;
  devHint: string;
  page: string;
}

const FALLBACK_TRANSLATIONS: SearchTranslations = {
  placeholder: 'Search',
  noresult: 'No results found.',
  error: 'Search failed. Please try again later.',
  label: 'Site search',
  hint: 'Type keywords to search this site',
  searching: 'Searching…',
  results: '{count} results',
  tip: '↑↓ select · Enter open · Esc close',
  devHint: 'Search index is not built yet: run pnpm build, then pnpm preview',
  page: 'Article',
};

let translations: SearchTranslations = FALLBACK_TRANSLATIONS;
// 当前弹窗文案 / 查询对应的语言；换语言后清掉旧输入与旧结果
let activeLocale = '';

// 索引按语言缓存；preparedLang 记住当前这份是哪种语言。
let prepared: PreparedIndex | null = null;
let preparedLang = '';
let hits: SearchHit[] = [];
let activeIndex = -1;
// 每次输入 / 清空都 +1：索引加载是异步的，回来时如果已经换了查询就丢掉旧结果
let searchSeq = 0;
let debounceTimer: ReturnType<typeof setTimeout> | undefined;
// 中文输入法拼写过程中 input 里是拼音，先不触发搜索，等 compositionend 再查
let composing = false;

function el<T extends Element>(id: string): T | null {
  return document.getElementById(id) as T | null;
}

function isOpen(): boolean {
  const modal = el<HTMLElement>('search-modal');
  return Boolean(modal && !modal.classList.contains('opacity-0'));
}

function readTranslations(): SearchTranslations | null {
  const modal = el<HTMLElement>('search-modal');
  if (!modal) return null;

  let byLocale: Record<string, SearchTranslations> | null = null;
  try {
    byLocale = JSON.parse(modal.getAttribute('data-i18n-search') || '{}');
  } catch {
    return null;
  }
  if (!byLocale) return null;

  return byLocale[currentLangFromUrl()] || Object.values(byLocale)[0] || null;
}

/**
 * 弹窗在 swup 容器外、不会随换页重建，所以文案按**当前地址**重新挑一份；
 * 语言变了就把已加载的索引作废（索引文件本身就是按语言拆开的）。
 */
function syncSearchLocale() {
  const next = readTranslations();
  if (!next) return;
  translations = next;

  const lang = currentLangFromUrl();
  const localeChanged = activeLocale !== '' && activeLocale !== lang;
  activeLocale = lang;

  if (localeChanged) {
    prepared = null;
    preparedLang = '';
    hits = [];
    activeIndex = -1;
    const input = el<HTMLInputElement>('search-input');
    if (input) input.value = '';
    // 弹窗虽然已经关了，但结果 DOM 还留在容器里；先把列表恢复成提示态，
    // 否则下一次打开会短暂闪出上一门语言的旧结果。
    showHint();
  }

  const modal = el<HTMLElement>('search-modal');
  modal?.setAttribute('aria-label', translations.label);
  el<HTMLElement>('search-results-list')?.setAttribute('aria-label', translations.label);

  const input = el<HTMLInputElement>('search-input');
  if (input) input.placeholder = `${translations.placeholder}...`;

  const hint = document.querySelector('[data-search-hint] p');
  if (hint) hint.textContent = translations.hint;

  const tip = document.querySelector('[data-search-tip]');
  if (tip) tip.textContent = translations.tip;
}

function setPageScrollLocked(locked: boolean) {
  const modal = el<HTMLElement>('search-modal');
  if (!modal) return;

  // 滚动锁是计数式的，而弹窗在容器外不会重建；「是否已上锁」必须记在 DOM 上，
  // 否则每次初始化闭包归零，会把并存的抽屉 / 灯箱锁一起打穿。
  const state = locked ? '1' : '0';
  if (modal.dataset.scrollLocked === state) return;
  modal.dataset.scrollLocked = state;
  if (locked) lockPageScroll();
  else unlockPageScroll();
}

function openModal() {
  const modal = el<HTMLElement>('search-modal');
  if (!modal) return;

  const lang = currentLangFromUrl();
  if (preparedLang && preparedLang !== lang) {
    prepared = null;
    preparedLang = '';
    hits = [];
    activeIndex = -1;
    const input = el<HTMLInputElement>('search-input');
    if (input) input.value = '';
    showHint();
  }

  const modalEl = modal as HTMLElement & { __closeTimer?: ReturnType<typeof setTimeout> };
  clearTimeout(modalEl.__closeTimer);

  modal.classList.remove('opacity-0', 'pointer-events-none');
  modal.offsetHeight;
  requestAnimationFrame(() => {
    modal.firstElementChild?.classList.remove('opacity-0');
    modal.firstElementChild?.classList.add('show');
    const content = modal.querySelector('.search-modal-content');
    content?.classList.remove('scale-90', 'opacity-0');
    content?.classList.add('scale-100');
  });

  const input = el<HTMLInputElement>('search-input');
  input?.setAttribute('aria-expanded', 'true');
  setTimeout(() => input?.focus(), 240);
  setPageScrollLocked(true);

  // 打开时就加载索引：首次会等一会儿，但输入框可以立刻打字
  void ensureIndex(false);
}

function closeModal() {
  const modal = el<HTMLElement>('search-modal');
  if (!modal) return;

  el<HTMLInputElement>('search-input')?.setAttribute('aria-expanded', 'false');

  const backdrop = modal.firstElementChild;
  const content = modal.querySelector('.search-modal-content');
  requestAnimationFrame(() => {
    backdrop?.classList.add('opacity-0');
    backdrop?.classList.remove('show');
    content?.classList.add('scale-90', 'opacity-0');
    content?.classList.remove('scale-100');
  });

  const modalEl = modal as HTMLElement & { __closeTimer?: ReturnType<typeof setTimeout> };
  clearTimeout(modalEl.__closeTimer);
  modalEl.__closeTimer = setTimeout(() => {
    modal.classList.add('opacity-0', 'pointer-events-none');
    // 等淡出结束再解锁：解锁早了，淡出的这几百毫秒里滚轮又能滚到后面的页面
    setPageScrollLocked(false);
  }, 240);
}

function setMessage(text: string, hint = false) {
  const list = el<HTMLElement>('search-results-list');
  if (!list) return;

  const box = document.createElement('div');
  box.className = 'p-8 text-center text-[var(--text-color-70)]';
  if (hint) box.setAttribute('data-search-hint', '');
  const paragraph = document.createElement('p');
  paragraph.textContent = text;
  box.append(paragraph);
  list.replaceChildren(box);
}

function updateCount(count: number | null) {
  const target = document.querySelector('[data-search-count]');
  if (!target) return;
  target.textContent = count === null ? '' : translations.results.replace('{count}', String(count));
}

function showHint() {
  searchSeq++;
  clearTimeout(debounceTimer);
  hits = [];
  activeIndex = -1;
  setMessage(translations.hint, true);
  updateCount(null);
  el<HTMLInputElement>('search-input')?.removeAttribute('aria-activedescendant');
}

function showIndexError(error: unknown) {
  searchSeq++;
  hits = [];
  activeIndex = -1;
  const message =
    error instanceof SearchIndexError && error.kind === 'missing'
      ? translations.devHint
      : translations.error;
  setMessage(message);
  updateCount(null);
  el<HTMLInputElement>('search-input')?.removeAttribute('aria-activedescendant');
}

async function ensureIndex(showSearching: boolean): Promise<PreparedIndex | null> {
  const lang = currentLangFromUrl();
  if (prepared && preparedLang === lang) return prepared;

  if (showSearching) setMessage(translations.searching);

  try {
    const index = await loadSearchIndex(lang);
    if (currentLangFromUrl() !== lang) return null;
    prepared = index;
    preparedLang = lang;
    return index;
  } catch (error) {
    showIndexError(error);
    return null;
  }
}

async function runSearch(query: string) {
  const seq = ++searchSeq;
  const lang = currentLangFromUrl();

  if (!prepared || preparedLang !== lang) {
    setMessage(translations.searching);
    const index = await ensureIndex(false);
    if (!index || seq !== searchSeq) return;
  }

  const current = el<HTMLInputElement>('search-input')?.value.trim() || '';
  if (current !== query || currentLangFromUrl() !== lang || !prepared) return;

  hits = search(prepared, query);
  activeIndex = hits.length > 0 ? 0 : -1;
  renderResults();
}

function renderResults() {
  const list = el<HTMLElement>('search-results-list');
  if (!list) return;

  if (hits.length === 0) {
    setMessage(translations.noresult);
    updateCount(0);
    el<HTMLInputElement>('search-input')?.removeAttribute('aria-activedescendant');
    return;
  }

  const fragment = document.createDocumentFragment();
  hits.forEach((hit, index) => {
    const link = document.createElement('a');
    link.className = 'search-hit';
    link.href = hit.url;
    link.id = `search-hit-${index}`;
    link.dataset.searchHit = '1';
    link.setAttribute('role', 'option');
    link.setAttribute('aria-selected', 'false');

    const head = document.createElement('div');
    head.className = 'search-hit-head';

    const title = document.createElement('span');
    title.className = 'search-hit-title';
    title.textContent = hit.title;
    head.append(title);

    if (hit.trail) {
      const trail = document.createElement('span');
      trail.className = 'search-hit-trail';
      trail.textContent = hit.trail;
      head.append(trail);
    } else if (!hit.anchor) {
      // 页面级结果没有锚点，用「文章」标一下，避免只显示一行标题
      const trail = document.createElement('span');
      trail.className = 'search-hit-trail';
      trail.textContent = translations.page;
      head.append(trail);
    }

    link.append(head);

    if (hit.parts.length > 0) {
      const snippet = document.createElement('p');
      snippet.className = 'search-hit-snippet';
      for (const part of hit.parts) {
        if (part.hit) {
          const mark = document.createElement('mark');
          mark.textContent = part.text;
          snippet.append(mark);
        } else {
          snippet.append(document.createTextNode(part.text));
        }
      }
      link.append(snippet);
    }

    fragment.append(link);
  });

  list.replaceChildren(fragment);
  updateCount(hits.length);
  setActive(0);
}

function hitElements(): HTMLAnchorElement[] {
  const list = el<HTMLElement>('search-results-list');
  return list ? Array.from(list.querySelectorAll<HTMLAnchorElement>('a[data-search-hit]')) : [];
}

function setActive(index: number) {
  const items = hitElements();
  const input = el<HTMLInputElement>('search-input');
  if (items.length === 0) {
    activeIndex = -1;
    input?.removeAttribute('aria-activedescendant');
    return;
  }

  activeIndex = ((index % items.length) + items.length) % items.length;
  items.forEach((item, i) => {
    const active = i === activeIndex;
    item.classList.toggle('is-active', active);
    item.setAttribute('aria-selected', active ? 'true' : 'false');
  });

  const active = items[activeIndex];
  input?.setAttribute('aria-activedescendant', active.id);
  // 结果列表由 OverlayScrollbars 接管，scrollIntoView 会找最近的滚动祖先
  active.scrollIntoView({ block: 'nearest' });
}

function handleInput() {
  if (composing) return;

  const input = el<HTMLInputElement>('search-input');
  if (!input) return;

  const query = input.value.trim();
  clearTimeout(debounceTimer);

  if (!query) {
    showHint();
    return;
  }

  debounceTimer = setTimeout(() => {
    void runSearch(query);
  }, 140);
}

function onInputKeyDown(event: KeyboardEvent) {
  if (!isOpen() || event.isComposing) return;

  if (event.key === 'ArrowDown') {
    event.preventDefault();
    setActive(activeIndex + 1);
  } else if (event.key === 'ArrowUp') {
    event.preventDefault();
    setActive(activeIndex - 1);
  } else if (event.key === 'Enter' && activeIndex >= 0) {
    const active = hitElements()[activeIndex];
    if (active) {
      event.preventDefault();
      active.click();
    }
  }
}

function bindSearchInput() {
  const input = el<HTMLInputElement>('search-input');
  if (!input || input.dataset.bound === 'true') return;
  input.dataset.bound = 'true';
  input.addEventListener('input', handleInput);
  input.addEventListener('keydown', onInputKeyDown);
  input.addEventListener('compositionstart', () => {
    composing = true;
  });
  input.addEventListener('compositionend', () => {
    composing = false;
    handleInput();
  });
}

function bindResultClicks() {
  const list = el<HTMLElement>('search-results-list');
  if (!list || list.dataset.bound === 'true') return;
  list.dataset.bound = 'true';

  // 同页 #锚点 点击不会派发 swup:visit:start，必须在这里主动收起弹窗；
  // 中键 / Ctrl 点击是新标签页，窗口保持打开。
  list.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const link = target?.closest('a[data-search-hit]');
    if (!link) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
    closeModal();
  });
}

function prefetchIndex() {
  const lang = currentLangFromUrl();
  const flag = `__momoSearchPrefetch_${lang}`;
  const scope = window as Window & Record<string, unknown>;
  if (scope[flag]) return;

  const connection = (navigator as Navigator & {
    connection?: { saveData?: boolean; effectiveType?: string };
  }).connection;
  if (connection?.saveData) return;
  if (connection?.effectiveType && /(^|-)2g$/.test(connection.effectiveType)) return;

  // 确认真的要预取后再置位，省流模式恢复后还能补一次
  scope[flag] = true;

  const run = () => {
    loadSearchIndex(lang).catch(() => {
      // 预取失败不打扰用户：打开搜索时还会再试一次并给出提示
    });
  };

  if (typeof window.requestIdleCallback === 'function') {
    window.requestIdleCallback(run, { timeout: 3000 });
  } else {
    setTimeout(run, 1200);
  }
}

function initSearchModal() {
  const searchButton = el<HTMLButtonElement>('search-button');
  const searchModal = el<HTMLElement>('search-modal');
  const closeSearch = el<HTMLButtonElement>('close-search');
  const searchInput = el<HTMLInputElement>('search-input');

  if (!searchButton || !searchModal) return;

  // 换页时本脚本会重新执行：先解绑上一次挂在 document 上的 keydown
  (window as Window & { __momoSearchModal?: { cleanup?: () => void } }).__momoSearchModal?.cleanup?.();

  const onKeyDown = (event: KeyboardEvent) => {
    const open = isOpen();

    if (event.key === 'Escape' && open) {
      event.preventDefault();
      closeModal();
      return;
    }

    // 全站快捷键：Ctrl/Cmd + K 打开搜索
    if (!open && (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openModal();
    }
  };

  const onVisitStart = () => closeModal();

  searchButton.onclick = openModal;
  if (closeSearch) closeSearch.onclick = closeModal;
  searchModal.onclick = (event) => {
    const content = searchModal.querySelector('.search-modal-content');
    if (!content?.contains(event.target as Node)) closeModal();
  };

  document.addEventListener('keydown', onKeyDown);
  document.addEventListener('swup:visit:start', onVisitStart);

  bindSearchInput();
  bindResultClicks();

  // 悬停 / 聚焦搜索按钮时提前拉索引，首次打开少等一会儿
  if (searchButton.dataset.prefetchBound !== '1') {
    searchButton.dataset.prefetchBound = '1';
    searchButton.addEventListener('pointerenter', prefetchIndex, { passive: true });
    searchButton.addEventListener('focus', prefetchIndex);
  }

  (window as Window & { __momoSearchModal?: { cleanup?: () => void } }).__momoSearchModal = {
    cleanup() {
      document.removeEventListener('keydown', onKeyDown);
      document.removeEventListener('swup:visit:start', onVisitStart);
    },
  };

  // 首屏 / 换页都确保输入框已绑定（元素常驻，dataset 保证只绑一次）
  bindSearchInput();
  if (searchInput) searchInput.placeholder = `${translations.placeholder}...`;
  prefetchIndex();
}

// 首屏 + 每次换页（swup 下首屏不会有 astro:page-load，见 @utils/pageInit）
registerPageInit(syncSearchLocale);
registerPageInit(initSearchModal);
registerPageInit(prefetchIndex);
</script>

<style>
  /* 遮罩只动画 opacity：backdrop-filter 逐帧插值会持续触发合成与重绘，
     模糊值固定为 2px（与原动画的终值一致），观感基本不变 */
  @keyframes backdropFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes backdropFadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  .modal-backdrop {
    background-color: rgba(0, 0, 0, 0.3);
    /* 注意：构建时的 CSS 压缩器会把 backdrop-filter 与 -webkit-backdrop-filter
       当作同一属性合并、只保留后写的那条，所以标准属性必须单独放进 @supports。 */
    -webkit-backdrop-filter: blur(2px);
    transition: opacity var(--momo-t-base) var(--momo-ease-out);
  }

  /* 弹窗本体：从 90% 弹出到 100%，带轻微过冲（--momo-ease-pop）。
     过渡写在 CSS 里而不是用 Tailwind 的 `transition duration-300`：
     那里是默认 ease、300ms，弹出来「软塌塌」的。
     ⚠️ scale-90 / scale-100 在 Tailwind v4 里改的是 `scale` 属性，不是 transform，
     所以这里必须单独列 scale，否则只有透明度在动、缩放是硬跳。 */
  .search-modal-content {
    transition:
      transform var(--momo-t-base) var(--momo-ease-pop),
      scale var(--momo-t-base) var(--momo-ease-pop),
      opacity var(--momo-t-base) var(--momo-ease-out);
  }

  @supports (backdrop-filter: blur(1px)) {
    .modal-backdrop {
      backdrop-filter: blur(2px);
    }
  }

  .modal-backdrop.show {
