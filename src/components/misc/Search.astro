---
import type { SearchResult } from "@/global"
import { baseUrl } from "@utils/urlUtils";
import { getEntry, render } from 'astro:content'
import { i18n } from "astro:config/client";
import i18nit from "@i18n/translation";



const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

// 搜索弹窗在 swup 容器之外，不会随换页重建：把**每种语言**的文案一起渲染进 data 属性，
// 由脚本里的 syncSearchLocale() 在每次换页后按当前地址（语言）挑出该用的那一份。
const localeCodes: string[] = (i18n?.locales ?? [currentLang]).map((l) =>
  typeof l === 'string' ? l : l.path,
);
const translationsByLocale = Object.fromEntries(
  localeCodes.map((code) => {
    const tr = i18nit(code);
    return [
      code,
      {
        placeholder: tr("search.placeholder"),
        error: tr("search.error"),
        noresult: tr("search.noresult"),
      },
    ];
  }),
);

const fakeResult: SearchResult[] = [
	{
		url: baseUrl("/"),
		meta: {
			title: "This Is a Fake Search Result",
		},
		excerpt:
			"Because the search cannot work in the <mark>dev</mark> environment.",
	},
	{
		url: baseUrl("/"),
		meta: {
			title: "If You Want to Test the Search",
		},
		excerpt: "Try running <mark>pnpm build && pnpm preview</mark> instead.",
  }
]
---
<!--
  层级：z-[1100] 必须高于右下角 FabMenu（#fabMenu 为 z-[1000]，其目录面板 z-[1001]
  是在 FAB 自己的层叠上下文里，所以盖过 1000 即可），否则遮罩与弹窗会压在 FAB 下面，
  浮动按钮会浮在遮罩之上；同时保持在图片灯箱（z-2000）之下。
-->
<div id="search-modal" data-i18n-search={JSON.stringify(translationsByLocale)} data-fake-results={JSON.stringify(fakeResult)} class="fixed inset-0 z-[1100] opacity-0 pointer-events-none">
  <div class="absolute inset-0 modal-backdrop opacity-0" aria-hidden="true"></div>

  <div class="fixed inset-0 flex items-start justify-center p-4 pt-[25vh]">
    <div class="search-modal-content bg-[var(--bg-color)] rounded-xl shadow-xl w-full max-w-2xl border border-[var(--button-border-color)] overflow-hidden scale-80 transition duration-300 opacity-0 flex flex-col max-h-[40vh]">
      <div class="flex items-center p-4 border-b border-[var(--button-border-color)]">
        <svg class="w-5 h-5 text-[var(--text-color-70)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          type="text" 
          id="search-input"
          placeholder={t("search.placeholder")+"..."}
          class="w-full bg-transparent border-0 focus:ring-0 focus:outline-none  text-[var(--text-color)]"
        />
        <button id="close-search" class="ml-2 p-2 text-[var(--text-color-70)] rounded-lg hover:bg-[var(--button-hover-color)] active:bg-[var(--button-hover-color)]" aria-label="Close Search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <!-- #search-results 是滚动容器（由 OverlayScrollbars 接管），
           #search-results-list 才是真正被 innerHTML 重写的目标。
           ⚠️ 两者必须分开：OS 会在容器里插入自己的包装层
           （data-overlayscrollbars-padding / -content），而 innerHTML 赋值会把
           这些包装层一起冲掉，实例当场失效。写到 list 上就只换它的子节点，
           OS 的结构完好，内容变化由它自己的 MutationObserver 接手。 -->
      <div id="search-results" class="overflow-y-auto flex-grow">
        <div id="search-results-list">
          <!-- data-search-hint：还停留在「默认提示」状态时，换页/换语言后要按当前语言改文案；
               已经是搜索结果时不动（见 syncSearchLocale） -->
          <div class="p-8 text-center text-[var(--text-color-70)]" data-search-hint>
            <p>{t("search.placeholder")}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
import { registerPageInit } from '@utils/pageInit';
import { currentLangFromUrl } from '@utils/locale';
import { lockPageScroll, unlockPageScroll } from '@utils/scrollLock';

/**
 * 搜索弹窗在 swup 容器之外、不会随换页重建，所以：
 * 1. 文案（placeholder / 空结果 / 出错）按**当前地址推导出的语言**重新挑一份
 *    （构建时每种语言的文案都渲染进了 #search-modal 的 data-i18n-search）；
 * 2. 挑出来的那份挂到 window 上，给下面那个 is:inline 的脚本用（它不能 import）。
 */
function syncSearchLocale() {
  const modal = document.getElementById('search-modal');
  if (!modal) return;

  let byLocale;
  try {
    byLocale = JSON.parse(modal.getAttribute('data-i18n-search') || '{}');
  } catch {
    return;
  }

  const tr = byLocale[currentLangFromUrl()] || Object.values(byLocale)[0];
  if (!tr) return;
  window.__momoSearchTranslations = tr;

  const input = document.getElementById('search-input');
  if (input) input.placeholder = `${tr.placeholder}...`;

  // 只改「默认提示」那一份；已经显示搜索结果 / 无结果时不要覆盖用户看到的内容
  const hint = document.getElementById('search-results')?.querySelector('[data-search-hint] p');
  if (hint) hint.textContent = tr.placeholder;
}

function initSearchModal() {
  const searchButton = document.getElementById('search-button');
  const searchModal = document.getElementById('search-modal');
  const closeSearch = document.getElementById('close-search');
  const searchInput = document.getElementById('search-input');
  const modalBackdrop = searchModal?.firstElementChild;
  const modalContent = searchModal?.querySelector('.search-modal-content');

  if (!searchButton || !searchModal) return;

  // 换页时本脚本会重新执行：先解绑上一次挂在 document 上的 keydown
  window.__momoSearchModal?.cleanup?.();

  // 定时器挂在**元素**上而不是闭包变量里：弹窗在 swup 容器外、换页不重建，
  // 而 initSearchModal 每次换页都会重建闭包（记在闭包里换页后就找不到了）。
  const modalEl = searchModal as HTMLElement & { __closeTimer?: ReturnType<typeof setTimeout> };

  // 弹窗打开时锁住整页滚动（锁 <html>，见 @utils/scrollLock）：
  // 遮罩与弹窗都不是滚动容器，滚轮 / 键盘会直接穿透到后面的页面。
  // 锁是计数式的，所以「是否已上锁」必须记在元素 dataset 上（闭包每次换页都重建），
  // 只在状态真的翻转时加减，否则会把并存的抽屉 / 灯箱锁一起打穿。
  const setPageScrollLocked = (locked: boolean) => {
    const state = locked ? '1' : '0';
    if (searchModal.dataset.scrollLocked === state) return;
    searchModal.dataset.scrollLocked = state;
    if (locked) lockPageScroll();
    else unlockPageScroll();
  };

  const openModal = () => {
    clearTimeout(modalEl.__closeTimer);
    searchModal.classList.remove('opacity-0', 'pointer-events-none');
    searchModal.offsetHeight;
    requestAnimationFrame(() => {
      modalBackdrop?.classList.remove('opacity-0');
      modalBackdrop?.classList.add('show');
      modalContent?.classList.remove('scale-80', 'opacity-0');
      modalContent?.classList.add('scale-100');
    });
    setTimeout(() => searchInput?.focus(), 300);
    setPageScrollLocked(true);
  };

  const closeModal = () => {
    requestAnimationFrame(() => {
      modalBackdrop?.classList.add('opacity-0');
      modalBackdrop?.classList.remove('show');
      modalContent?.classList.add('scale-80', 'opacity-0');
      modalContent?.classList.remove('scale-100');
    });
    clearTimeout(modalEl.__closeTimer);
    modalEl.__closeTimer = setTimeout(() => {
      searchModal.classList.add('opacity-0', 'pointer-events-none');
      // 等淡出结束再解锁：解锁早了，淡出的这 300ms 里滚轮又能滚到后面的页面
      setPageScrollLocked(false);
    }, 300);
  };

  // 搜索按钮在 swup 容器外的顶栏里，用 onclick 赋值保证幂等
  searchButton.onclick = openModal;
  if (closeSearch) closeSearch.onclick = closeModal;
  searchModal.onclick = (e) => {
    if (!modalContent?.contains(e.target)) closeModal();
  };

  const onKeyDown = (e) => {
    if (e.key === 'Escape' && !searchModal.classList.contains('opacity-0')) {
      closeModal();
    }
  };
  document.addEventListener('keydown', onKeyDown);

  // 换页开始时收掉搜索弹窗：它在 swup 容器外不会重建，
  // 而点搜索结果里的链接不会关掉它（以前靠整页替换复位）
  const onVisitStart = () => closeModal();
  document.addEventListener('swup:visit:start', onVisitStart);

  window.__momoSearchModal = {
    cleanup() {
      document.removeEventListener('keydown', onKeyDown);
      document.removeEventListener('swup:visit:start', onVisitStart);
    },
  };
}

// 首屏 + 每次换页（swup 下首屏不会有 astro:page-load，见 @utils/pageInit）
registerPageInit(syncSearchLocale);
registerPageInit(initSearchModal);
</script>


<style>
  /* 遮罩只动画 opacity：backdrop-filter 逐帧插值会持续触发合成与重绘，
     模糊值固定为 2px（与原动画的终值一致），观感基本不变 */
  @keyframes backdropFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes backdropFadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  
  .modal-backdrop {
    background-color: rgba(0, 0, 0, 0.3);
    /* 注意：构建时的 CSS 压缩器会把 backdrop-filter 与 -webkit-backdrop-filter
       当作同一属性合并、只保留后写的那条，所以标准属性必须单独放进 @supports。 */
    -webkit-backdrop-filter: blur(2px);
    transition: opacity 0.3s ease-out;
  }

  @supports (backdrop-filter: blur(1px)) {
    .modal-backdrop {
      backdrop-filter: blur(2px);
    }
  }
  
  .modal-backdrop.show {
    animation: backdropFadeIn 0.3s ease-out forwards;
  }
  
  .modal-backdrop:not(.show) {
    animation: backdropFadeOut 0.3s ease-out forwards;
  }
  
  #search-input::-webkit-input-placeholder {
    color: var(--text-color-70);
  }
  
  #search-input::-moz-placeholder {
    color: var(--text-color-70);
  }
</style>

<script is:inline data-swup-ignore-script>
// data-swup-ignore-script：swup 换页时会重放文档里的内联脚本，而这个脚本
// 只该执行一次（搜索弹窗在容器外，重复执行只会让 astro:page-load 监听器成倍累积）。
//
// ⚠️ 这里不能用 define:vars 注入 fakeResult / translations：Astro 会丢掉 define:vars
// 内联脚本上的其它属性（包括 data-swup-ignore-script），脚本就会被反复重放。
// 构建期的值统一放在 #search-modal 的 data-* 上（data-i18n-search / data-fake-results）。
//
// 文案在运行时按当前语言取：syncSearchLocale()（上面那个模块脚本）会把当前语言那份
// 挂到 window.__momoSearchTranslations；它还没跑时退回 data-i18n-search 里查一份。
function tr() {
  if (window.__momoSearchTranslations) return window.__momoSearchTranslations;
  try {
    const all = JSON.parse(document.getElementById('search-modal')?.getAttribute('data-i18n-search') || '{}');
    const lang = (document.documentElement.lang || '').toLowerCase();
    const hit = Object.entries(all).find(([code]) => code.toLowerCase() === lang) || Object.entries(all)[0];
    if (hit) {
      window.__momoSearchTranslations = hit[1];
      return hit[1];
    }
  } catch {
    /* 忽略：退回下面的兜底文案 */
  }
  return { placeholder: 'Search', error: 'Search failed', noresult: 'No results' };
}

/** 开发环境（或索引未加载成功）时用的假数据 */
function fakeResults() {
  try {
    return JSON.parse(document.getElementById('search-modal')?.getAttribute('data-fake-results') || '[]');
  } catch {
    return [];
  }
}

function initPagefindSearch() {
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  // innerHTML 只写到 list 上：#search-results 是 OverlayScrollbars 的宿主，
  // 直接重写它的 innerHTML 会把 OS 的包装层一起冲掉（见上面标记处的说明）
  const searchList = document.getElementById('search-results-list');
  
  if (!searchInput || !searchResults || !searchList) return;

  // 避免重复绑定
  if (searchInput.dataset.bound === 'true') return;
  searchInput.dataset.bound = 'true';

  let searchTimeout;

  searchInput.addEventListener('input', (e) => {
    const query = e.target.value.trim();
    clearTimeout(searchTimeout);
    
    searchTimeout = setTimeout(() => {
      if (query.length > 0) {
        performSearch(query);
      } else {
        // 清空或显示默认状态（data-search-hint 让换页时的语言同步认得这块提示）
        searchList.innerHTML = `
          <div class="p-8 text-center text-[var(--text-color-70)]" data-search-hint>
            <p>${tr().placeholder}</p>
          </div>
        `;
      }
    }, 300);
  });
}

// 等待 Pagefind 就绪：Header 里的加载器会派发 pagefind-ready 事件
// （原实现监听的是 pagefindready，名字对不上，所以永远等不到通知）
function waitForPagefind(timeout = 4000) {
  if (window.pagefind) return Promise.resolve(window.pagefind);
  return new Promise((resolve) => {
    const done = () => {
      document.removeEventListener('pagefind-ready', done);
      resolve(window.pagefind ?? null);
    };
    document.addEventListener('pagefind-ready', done, { once: true });
    setTimeout(done, timeout);
  });
}

async function performSearch(query) {
  const searchList = document.getElementById('search-results-list');
  const pagefind = window.pagefind ?? (await waitForPagefind());

  // 开发环境（或索引未加载成功）时退回假数据
  const isDev = !pagefind;

  if (isDev) {
    displayResults(fakeResults());
  } else {
    // 只需要初始化一次：重复调用 search() 即可，不必每次 destroy + init
    try {
      const searchResultsData = await pagefind.search(query);

      // 并发取回每条结果的数据（原来是逐条 await，串行等待）
      const results = (await Promise.all(
        searchResultsData.results.map(async (result) => {
          const data = await result.data();
          return {
            url: data.url,
            meta: { title: data.meta.title },
            excerpt: data.excerpt
          };
        })
      ));

      displayResults(results);
    } catch (error) {
      console.error('Search failed:', error);
      searchList.innerHTML = `
        <div class="p-8 text-center text-red-500">
          <p>${tr().error}</p>
        </div>
      `;
    }
  }
}

function displayResults(results) {
  // 只重写 #search-results-list：#search-results 是 OverlayScrollbars 的宿主，
  // 直接写它的 innerHTML 会把 OS 的包装层冲掉（见 initPagefindSearch 的说明）
  const searchList = document.getElementById('search-results-list');
  if (!searchList) return;

  if (results.length === 0) {
    searchList.innerHTML = `
      <div class="p-8 text-center text-[var(--text-color-70)]">
        <p>${tr().noresult}</p>
      </div>
    `;
    return;
  }

  searchList.innerHTML = results.map(result => `
    <div class="p-4 border-b border-[var(--button-border-color)] hover:bg-[var(--button-hover-color)]">
      <a href="${result.url}" class="block no-underline">
        <h3 class="text-lg font-semibold text-[var(--text-color)] mb-2">${result.meta.title}</h3>
        <p class="text-[var(--text-color-70)] text-sm">${result.excerpt}</p>
      </a>
    </div>
  `).join('');
}

// ========== 初始化逻辑 ==========
document.addEventListener('pagefind-ready', () => {
  // console.log('Pagefind is ready');
});
document.addEventListener('pagefindloaderror', () => {
  console.log('Pagefind failed to load, search functionality will not work');
});

// swup 下首屏不会派发 astro:page-load，所以这里先跑一次；
// 监听 astro:page-load 只是兜底（dataset.bound 保证不会重复绑定）
initPagefindSearch();
document.addEventListener('astro:page-load', initPagefindSearch);
</script>


<style is:global>
mark {
  background-color: #ffeb3b00;
  color: var(--link-color);
  padding: 0 2px;
  font-weight: 600;
}
</style>