      { name: '--accent-bg', label: isEn ? 'Brand (fill)' : '品牌蓝（底色）', usage: isEn ? 'primary button' : '主按钮、选中态' },
      { name: '--accent-fg', label: isEn ? 'On brand' : '品牌色上的文字', usage: isEn ? 'text on accent' : '蓝底上的白字' },
      { name: '--accent-soft', label: isEn ? 'Brand tint' : '品牌淡底', usage: isEn ? 'soft highlight' : '选中底色、光晕' },
    ],
  },
  {
    key: 'semantic',
    items: [
      { name: '--success-color', label: isEn ? 'Success' : '成功', usage: isEn ? 'tip callout' : 'tip 提示块' },
      { name: '--success-bg-color', label: isEn ? 'Success surface' : '成功底色', usage: isEn ? 'tip callout' : 'tip 提示块底色' },
      { name: '--error-color', label: isEn ? 'Error' : '错误', usage: isEn ? 'caution callout' : 'caution 提示块' },
      { name: '--error-bg-color', label: isEn ? 'Error surface' : '错误底色', usage: isEn ? 'caution callout' : 'caution 提示块底色' },
      { name: '--warning-color', label: isEn ? 'Warning' : '警告', usage: isEn ? 'warning callout' : 'warning 提示块' },
      { name: '--warning-bg-color', label: isEn ? 'Warning surface' : '警告底色', usage: isEn ? 'warning callout' : 'warning 提示块底色' },
      { name: '--info-color', label: isEn ? 'Info' : '提示', usage: isEn ? 'important callout' : 'important 提示块' },
      { name: '--info-bg-color', label: isEn ? 'Info surface' : '提示底色', usage: isEn ? 'important callout' : 'important 提示块底色' },
    ],
  },
];

const typeScale = [
  { name: '--momo-font-size-2xs', usage: isEn ? 'badges / labels' : '角标、极小说明', sample: 'Momo Ag 123' },
  { name: '--momo-font-size-xs', usage: isEn ? 'captions / meta' : '说明、元信息', sample: 'Momo Ag 123' },
  { name: '--momo-font-size-sm', usage: isEn ? 'secondary text' : '次要正文', sample: 'Momo Ag 123' },
  { name: '--momo-font-size-md', usage: isEn ? 'body in UI' : '界面正文', sample: 'Momo Ag 123' },
  { name: '--momo-font-size-base', usage: isEn ? 'article body' : '文章正文', sample: 'Momo Ag 123' },
  { name: '--momo-font-size-lg', usage: isEn ? 'card title / prose h5 (18px)' : '卡片标题、正文 h5（18px）', sample: 'Momo Ag 123' },
  { name: '--momo-font-size-xl', usage: isEn ? 'card title large' : '大卡片标题', sample: 'Momo Ag 123' },
  { name: '--momo-font-size-2xl', usage: isEn ? 'section heading' : '分区标题', sample: 'Momo Ag 123' },
  { name: '--momo-font-size-3xl', usage: isEn ? 'prose h2 (28px)' : '正文 h2（28px）', sample: 'Momo 设计规范' },
  { name: '--momo-font-size-4xl', usage: isEn ? 'article h1' : '文章一级标题', sample: 'Momo 设计规范' },
  { name: '--momo-font-size-display', usage: isEn ? 'design hero (clamp 36–56px)' : '规范页 hero（clamp 36–56px）', sample: 'Momo 设计规范' },
];

const weights = [
  { name: '--momo-font-weight-regular', value: '400' },
  { name: '--momo-font-weight-medium', value: '500' },
  { name: '--momo-font-weight-semibold', value: '600' },
  { name: '--momo-font-weight-bold', value: '700' },
];

const leadings = [
  { name: '--momo-leading-tight', value: '1.25', usage: isEn ? 'headings' : '标题' },
  { name: '--momo-leading-normal', value: '1.5', usage: isEn ? 'UI copy' : '界面文字' },
  { name: '--momo-leading-relaxed', value: '1.75', usage: isEn ? 'long copy' : '长文正文' },
];

const fontStacks = [
  { name: '--momo-font-serif', label: isEn ? 'Source Serif · body' : '思源宋体 · 正文', sample: isEn ? 'Life is colorful.' : '生活多彩，记录当下。' },
  { name: '--momo-font-display', label: isEn ? 'EB Garamond · wordmark' : 'EB Garamond · 站名', sample: 'Momo' },
  { name: '--momo-font-sans', label: isEn ? 'WenKai · UI' : '霞鹜文楷 · 界面', sample: 'Search / 搜索' },
  { name: '--momo-font-mono', label: isEn ? 'JetBrains Mono · code' : 'JetBrains Mono · 代码', sample: 'const token = 8;' },
];

const spaces = Array.from({ length: 10 }, (_, index) => `--momo-space-${index + 1}`);
const radii = [
  { name: '--momo-radius-xs', usage: isEn ? 'inline code / tag' : '行内代码、角标（tag）' },
  { name: '--momo-radius-sm', usage: isEn ? 'chip / tooltip / callout' : '分类 chip、提示块、气泡' },
  { name: '--momo-radius-md', usage: isEn ? 'buttons / fields / rows' : '按钮、输入框、列表行' },
  { name: '--momo-radius-lg', usage: isEn ? 'cards / code blocks' : '卡片、代码块' },
  { name: '--momo-radius-xl', usage: isEn ? 'modals / drawers' : '弹窗、抽屉' },
  { name: '--momo-radius-pill', usage: isEn ? 'pills / avatars' : '胶囊、头像' },
];
const shadows = ['xs', 'sm', 'md', 'lg', 'xl'].map((level) => ({
  name: `--momo-shadow-${level}`,
  label: (t.shadow as Record<string, string>)[level],
}));
const durations = [
  { name: '--momo-t-fast', usage: t.motion.fast },
  { name: '--momo-t-base', usage: t.motion.base },
  { name: '--momo-t-slow', usage: t.motion.slow },
  { name: '--momo-t-press', usage: t.motion.press },
  { name: '--momo-t-reveal', usage: t.motion.reveal },
  { name: '--momo-t-reveal-row', usage: t.motion.revealRow },
];
const easings = [
  { name: '--momo-ease-out', label: isEn ? 'settle · no overshoot' : '收尾 · 不过冲' },
  { name: '--momo-ease-pop', label: isEn ? 'light overshoot' : '轻微过冲' },
  { name: '--momo-ease-sheet', label: isEn ? 'sheet · fast in, slow out' : '抽屉 · 快起慢收' },
];
const breakpoints = [
  { value: '640px', label: isEn ? 'Tailwind sm · small phone' : 'Tailwind sm · 小屏手机' },
  { value: '776px', label: isEn ? 'site mobile boundary · TOC / FabMenu' : '站点移动端分界 · 目录 / 悬浮按钮' },
  { value: '1024px', label: isEn ? 'Tailwind lg · desktop layout' : 'Tailwind lg · 桌面布局' },
];
const structureRows = t.structure.rows as unknown as string[][];
---

<MainPageLayout
  title={`${t.title} - Momo`}
  lang={currentLang}
  description={t.description}
  noindex={true}
  markdownFont={true}
  mathStyles={mathStyles}
>
  <div class="ds-page" data-search-ignore>
    <header class="ds-hero">
      <span class="ds-eyebrow">{t.eyebrow}</span>
      <h1 class="ds-title">{t.title}</h1>
      <p class="ds-lead">{t.lead}</p>
    </header>

    <div class="ds-layout">
      <aside class="ds-toc" aria-label={t.toc}>
        <p class="ds-toc-title">{t.toc}</p>
        <ol>
          {nav.map((item) => (
            <li><a href={`#${item.id}`} data-index={item.index}>{item.title}</a></li>
          ))}
        </ol>
      </aside>

      <div class="ds-content">
        <!-- 01 色彩 -->
        <section class="ds-section" id="color">
          <div class="ds-section-head">
            <span class="ds-index">01</span>
            <h2>{t.sections.color.title}</h2>
          </div>
          <p>{t.sections.color.desc}</p>

          {colorGroups.map((group) => (
            <div>
              <h3>{(t.colors as Record<string, string>)[group.key]}</h3>
              <div class="ds-grid ds-grid--colors">
                {group.items.map((item) => (
                  <article class="ds-swatch">
                    <div class="ds-swatch-chip" style={`--swatch: var(${item.name})`}></div>
                    <div class="ds-swatch-body">
                      <code class="ds-swatch-name">{item.name}</code>
                      <span class="ds-swatch-value">{t.colors.light} {token(item.name)}</span>
                      <span class="ds-swatch-value">{t.colors.dark} {token(item.name, true)}</span>
                      <span class="ds-swatch-usage">{item.label} · {item.usage}</span>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </section>

        <!-- 02 排版 -->
        <section class="ds-section" id="type">
          <div class="ds-section-head">
            <span class="ds-index">02</span>
            <h2>{t.sections.type.title}</h2>
          </div>
          <p>{t.sections.type.desc}</p>

          <h3>{t.type.scale}</h3>
          <div>
            {typeScale.map((item) => (
              <div class="ds-type-row">
                <div class="ds-type-meta">
                  <code class="ds-type-token">{item.name}</code>
                  <span class="ds-type-value">{token(item.name)} · {item.usage}</span>
                </div>
                <span class="ds-type-sample" style={`font-size: var(${item.name})`}>{item.sample}</span>
              </div>
            ))}
          </div>

          <h3>{t.type.weights}</h3>
          <div class="ds-font-list">
            {weights.map((item) => (
              <div class="ds-font-row">
                <span style={`font-weight: ${item.value}`}>{isEn ? 'Momo Design System' : 'Momo 设计规范 Ag'}</span>
                <span class="ds-font-meta">{item.name} · {item.value}</span>
              </div>
            ))}
          </div>

          <h3>{t.type.leading}</h3>
          <div class="ds-font-list">
            {leadings.map((item) => (
              <div class="ds-font-row">
                <span style={`line-height: ${item.value}; font-size: var(--momo-font-size-sm)`}>
                  {isEn
                    ? 'A line of copy that wraps, so the rhythm of the text is visible at a glance.'
                    : '一段需要换行的文字，用来看清不同行高对阅读节奏的影响。'}
                </span>
                <span class="ds-font-meta">{item.name} · {item.value} · {item.usage}</span>
              </div>
            ))}
          </div>

          <h3>{t.type.fonts}</h3>
          <div class="ds-font-list">
            {fontStacks.map((item) => (
              <div class="ds-font-row">
                <span class="ds-font-sample" style={`font-family: var(${item.name})`}>{item.sample}</span>
                <span class="ds-font-meta">{item.label}<br />{item.name}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- 03 间距 -->
        <section class="ds-section" id="space">
          <div class="ds-section-head">
            <span class="ds-index">03</span>
            <h2>{t.sections.space.title}</h2>
          </div>
          <p>{t.sections.space.desc}</p>
          {spaces.map((name) => (
            <div class="ds-space-row">
              <code class="ds-space-token">{name}</code>
              <span class="ds-space-value">{token(name)}</span>
              <span class="ds-space-bar" style={`width: calc(var(${name}) * 3)`}></span>
            </div>
          ))}
        </section>

        <!-- 04 圆角 -->
        <section class="ds-section" id="radius">
          <div class="ds-section-head">
            <span class="ds-index">04</span>
            <h2>{t.sections.radius.title}</h2>
          </div>
          <p>{t.sections.radius.desc}</p>
          <div class="ds-grid ds-grid--radius">
            {radii.map((item) => (
              <div class="ds-radius-tile">
                <span class="ds-radius-box" style={`--radius: var(${item.name})`}></span>
                <code class="ds-radius-name">{item.name.replace('--momo-radius-', '')}</code>
                <span class="ds-radius-value">{token(item.name)}</span>
                <span class="ds-radius-value">{item.usage}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- 05 阴影 -->
        <section class="ds-section" id="shadow">
          <div class="ds-section-head">
            <span class="ds-index">05</span>
            <h2>{t.sections.shadow.title}</h2>
          </div>
          <p>{t.sections.shadow.desc}</p>
          <div class="ds-grid ds-grid--shadow">
            {shadows.map((item) => (
              <div class="ds-shadow-card" style={`--shadow: var(${item.name})`}>
                <strong>{item.name.replace('--momo-shadow-', '').toUpperCase()}</strong>
                <span class="ds-hint">{item.label}</span>
                <code class="ds-hint">{item.name}</code>
              </div>
            ))}
          </div>
        </section>

        <!-- 06 动效 -->
        <section class="ds-section" id="motion">
          <div class="ds-section-head">
            <span class="ds-index">06</span>
            <h2>{t.sections.motion.title}</h2>
          </div>
          <p>{t.sections.motion.desc}</p>

          <h3>{t.motion.duration}</h3>
          <div class="ds-motion-table">
            {durations.map((item) => (
              <div class="ds-motion-row">
                <code class="ds-motion-token">{item.name}</code>
                <span class="ds-motion-value">{token(item.name)}</span>
                <span class="ds-hint">{item.usage}</span>
              </div>
            ))}
          </div>

          <h3>{t.motion.easing}</h3>
          <div class="ds-motion-table">
            {easings.map((item) => (
              <div class="ds-motion-row">
                <code class="ds-motion-token">{item.name}</code>
                <span class="ds-motion-value">{token(item.name)}</span>
                <span class="ds-hint">{item.label}</span>
              </div>
            ))}
          </div>

          <p class="ds-hint">
            {isEn
              ? `Entry travel: cards rise ${token('--momo-rise-card')} with a 0.96 scale (--momo-ease-pop); prose blocks rise ${token('--momo-rise-prose')} (--momo-ease-out).`
              : `入场行程：卡片上移 ${token('--momo-rise-card')} 并带 0.96 缩放（--momo-ease-pop），正文块上移 ${token('--momo-rise-prose')}（--momo-ease-out）。`}
          </p>

          <h3>{isEn ? 'Preview' : '现场演示'}</h3>
          <div class="ds-motion-table">
            {durations.slice(0, 3).map((item, index) => (
              <div class="ds-motion-demo" id={`ds-demo-${index}`} data-ds-demo>
                <code class="ds-motion-token">{item.name}</code>
                <span class="ds-motion-track">
                  <span
                    class="ds-motion-dot"
                    style={`--duration: var(${item.name}); --ease: var(--momo-ease-out)`}
                  ></span>
                </span>
                <button class="momo-btn momo-btn--sm" type="button" data-ds-replay={`ds-demo-${index}`}>
                  {t.motion.replay}
                </button>
              </div>
            ))}
          </div>

          <div class="ds-lift-grid" style="margin-top: var(--momo-space-4)">
            <div class="ds-lift-card">--momo-lift · -1px</div>
            <div class="ds-lift-card">--momo-lift-card · -2px</div>
            <div class="ds-lift-card">--momo-lift-emoji · -4px</div>
          </div>
        </section>

        <!-- 07 按钮 -->
        <section class="ds-section" id="button">
          <div class="ds-section-head">
            <span class="ds-index">07</span>
            <h2>{t.sections.button.title}</h2>
          </div>
          <p>{t.sections.button.desc}</p>

          <h3>{t.buttons.variants}</h3>
          <div class="ds-grid ds-grid--buttons">
            <button class="momo-btn momo-btn--primary" type="button">{t.buttons.primary}</button>
            <button class="momo-btn" type="button">{t.buttons.default}</button>
            <button class="momo-btn momo-btn--ghost" type="button">{t.buttons.ghost}</button>
            <button class="momo-btn" type="button" disabled>{t.buttons.disabled}</button>
            <button class="momo-btn momo-btn--icon" type="button" aria-label={t.buttons.icon}>
              <Icon name="fa6-solid:magnifying-glass" class="w-4 h-4" />
            </button>
          </div>

          <h3>{t.buttons.sizes}</h3>
          <div class="ds-grid ds-grid--buttons">
            <button class="momo-btn momo-btn--sm" type="button">{t.buttons.sm}</button>
            <button class="momo-btn" type="button">{t.buttons.md}</button>
            <button class="momo-btn momo-btn--lg" type="button">{t.buttons.lg}</button>
          </div>
        </section>

        <!-- 08 表单 -->
        <section class="ds-section" id="field">
          <div class="ds-section-head">
            <span class="ds-index">08</span>
            <h2>{t.sections.field.title}</h2>
          </div>
          <p>{t.sections.field.desc}</p>
          <div class="ds-field-grid">
            <label>
              <span class="ds-label">{t.fields.name}</span>
              <input class="momo-field" type="text" placeholder={t.fields.placeholder} />
            </label>
            <label>
              <span class="ds-label">{t.fields.disabled}</span>
              <input class="momo-field" type="text" value={t.fields.disabled} disabled />
            </label>
            <label>
              <span class="ds-label">{t.fields.textarea}</span>
              <textarea class="momo-field" rows="3" placeholder={t.fields.placeholder}></textarea>
            </label>
          </div>
        </section>

        <!-- 09 卡片 -->
        <section class="ds-section" id="card">
          <div class="ds-section-head">
            <span class="ds-index">09</span>
            <h2>{t.sections.card.title}</h2>
          </div>
          <p>{t.sections.card.desc}</p>

          <div class="ds-card-stack">
            {sampleEntry && (
              <div>
                <h3>{t.cards.post}</h3>
                <PostCard
                  entry={sampleEntry}
                  title={sampleEntry.data.title}
                  description={sampleEntry.data.description}
                  image={blogCoverUrl(sampleEntry.data.image, sampleEntry.id)}
                  pubDate={sampleEntry.data.pubDate}
                  url={sampleEntry.id}
                  fallback={sampleEntry.isFallback}
                />
              </div>
            )}

            <div class="ds-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
              <div class="momo-card ds-tile">
                <strong>{t.cards.static}</strong>
                <p class="ds-hint">{t.cards.staticDesc}</p>
              </div>
              <div class="momo-card momo-card--interactive ds-tile">
                <strong>{t.cards.hover}</strong>
                <p class="ds-hint">{t.cards.hoverDesc}</p>
              </div>
            </div>

            <div>
              <h3>{t.cards.friend}</h3>
              <a
                class="momo-card group flex items-center justify-between p-4 hover:bg-[var(--button-hover-color)] active:bg-[var(--button-hover-color)] transition-colors duration-300"
                href={isEn ? '/en/friends/' : '/friends/'}
                aria-label={t.cards.friend}
              >
                <div class="flex items-center min-w-0">
                  <img src={avatarSrc.src} alt="" class="w-16 h-16 rounded-full object-cover mr-4 flex-shrink-0" />
                  <div class="min-w-0">
                    <h4 class="font-bold text-lg truncate transition-colors duration-300 group-hover:text-[var(--link-color)] group-active:text-[var(--link-color)]">Momo</h4>
                    <p class="text-[var(--text-color-70)] text-sm truncate">{t.cards.friendDesc}</p>
                  </div>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-5 h-5 text-[var(--link-color)] opacity-0 transform translate-x-[-10px] group-hover:opacity-100 group-hover:translate-x-0 group-active:opacity-100 group-active:translate-x-0 transition duration-300 ml-2 flex-shrink-0"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            </div>
          </div>
        </section>

        <!-- 10 标签 -->
        <section class="ds-section" id="tag">
          <div class="ds-section-head">
            <span class="ds-index">10</span>
            <h2>{t.sections.tag.title}</h2>
          </div>
          <p>{t.sections.tag.desc}</p>
          <div class="ds-grid ds-grid--buttons">
            <button class="momo-chip is-active" type="button">{t.tags.all}</button>
            <button class="momo-chip" type="button">{t.tags.selected}</button>
            <span class="momo-tag">{t.tags.category}</span>
            <span class="momo-tag" style="font-family: var(--momo-font-mono); text-transform: uppercase">zh-cn</span>
          </div>
        </section>

        <!-- 11 提示 -->
        <section class="ds-section" id="notice">
          <div class="ds-section-head">
            <span class="ds-index">11</span>
            <h2>{t.sections.notice.title}</h2>
          </div>
          <p>{t.sections.notice.desc}</p>
          <div class="ds-admonition-grid">
            <div class="note"><span class="admonition-title">NOTE</span><p>{t.notices.note}</p></div>
            <div class="tip"><span class="admonition-title">TIP</span><p>{t.notices.tip}</p></div>
            <div class="important"><span class="admonition-title">IMPORTANT</span><p>{t.notices.important}</p></div>
            <div class="warning"><span class="admonition-title">WARNING</span><p>{t.notices.warning}</p></div>
            <div class="caution"><span class="admonition-title">CAUTION</span><p>{t.notices.caution}</p></div>
          </div>
        </section>

        <!-- 12 版式 -->
        <section class="ds-section" id="layout">
          <div class="ds-section-head">
            <span class="ds-index">12</span>
            <h2>{t.sections.layout.title}</h2>
          </div>
          <p>{t.sections.layout.desc}</p>
          <div class="ds-container-diagram">
            <div class="ds-container-bar">
              <span>{t.layout.header}</span>
              <code>--header-width</code>
            </div>
            <div class="ds-container-bar ds-container-bar--narrow">
              <span>{t.layout.page}</span>
              <code>--page-width</code>
            </div>
          </div>

          <h3>{t.layout.breakpoints}</h3>
          <div class="ds-breakpoints">
            {breakpoints.map((item) => (
              <div class="ds-breakpoint">
                <b>{item.value}</b>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- 13 正文 -->
        <section class="ds-section" id="prose">
          <div class="ds-section-head">
            <span class="ds-index">13</span>
            <h2>{t.sections.prose.title}</h2>
          </div>
          <p>{t.sections.prose.desc}</p>
          <div class="ds-prose-demo">
            <Markdown noReveal={true}>
              {ProseSample && <ProseSample />}
            </Markdown>
          </div>
        </section>

        <!-- 14 自定义语法 -->
        <section class="ds-section" id="custom">
          <div class="ds-section-head">
            <span class="ds-index">14</span>
            <h2>{t.sections.custom.title}</h2>
          </div>
          <p>{t.sections.custom.desc}</p>

          <div class="ds-custom-cards">
            <div class="ds-custom-block">
              <h3>{t.custom.github}</h3>
              <code class="ds-custom-syntax">{t.custom.githubSyntax}</code>
              {/* 真实指令渲染：卡片数据由插件自带的脚本实时请求，与文章页完全一致 */}
              <Markdown noReveal={true}>
                {GithubCardSample && <GithubCardSample />}
              </Markdown>
            </div>

            <div class="ds-custom-block">
              <h3>{t.custom.music}</h3>
              <code class="ds-custom-syntax">{t.custom.musicSyntax}</code>
              <Markdown noReveal={true}>
                {MusicCardSample && <MusicCardSample />}
              </Markdown>
            </div>
          </div>

          <div class="ds-custom-block">
            <h3>{t.custom.quote}</h3>
            <code class="ds-custom-syntax">{t.custom.quoteSyntax}</code>
            <div class="quote">
              <p>{t.custom.quoteBody}</p>
            </div>
          </div>

          <div class="ds-custom-block">
            <h3>{t.custom.inline}</h3>
            <code class="ds-custom-syntax">{t.custom.inlineSyntax}</code>
            <p class="ds-inline-demo">
              <ruby>{t.custom.ruby}<rt>{t.custom.rubyReading}</rt></ruby>
              <span class="spoiler">{t.custom.spoiler}</span>
              <span class="rainbow-text">{t.custom.rainbow}</span>
              <span class="underline-text">{t.custom.underline}</span>
            </p>
          </div>
        </section>

        <!-- 15 评论 -->
        <section class="ds-section" id="comment">
          <div class="ds-section-head">
            <span class="ds-index">15</span>
            <h2>{t.sections.comment.title}</h2>
          </div>
          <p>{t.sections.comment.desc}</p>
          <p class="ds-hint">{t.sections.comment.note}</p>
          <div class="ds-comment-demo">
            <!-- 评论条目：与 CommentItem.svelte 同结构（40px 头像 + 昵称 / 时间 + 正文 + 回复） -->
            <div class="flex gap-2 md:gap-3 w-full max-w-full">
              <img src={avatarSrc.src} alt="" class="w-10 h-10 rounded-full object-cover shrink-0" />
              <div class="flex-1 min-w-0">
                <div class="flex items-center flex-wrap gap-x-2 gap-y-1">
                  <span class="font-semibold text-[var(--text-color)]">{t.comments.name}</span>
                  <span class="text-sm text-[var(--text-color-70)]">{t.comments.time}</span>
                </div>
                <div
                  class="text-[var(--text-color)] mt-1 leading-relaxed w-full max-w-full min-w-0 text-sm comment-content"
                  set:html={t.comments.body}
                >
                </div>
                <div class="mt-1 flex items-center gap-4 text-sm text-[var(--text-color-70)]">
                  <button type="button" class="hover:text-[var(--link-color)]">{t.comments.reply}</button>
                </div>
              </div>
            </div>

            <!-- 评论表单：与 Comments.svelte 同结构（昵称 / 邮箱 / 网址 + 正文 + 预览 / 发送） -->
            <div class="space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                  <label for="ds-comment-name" class="block text-sm text-[var(--text-color)] mb-1">
                    {t.comments.nameLabel}<span class="text-red-500">*</span>
                  </label>
                  <input
                    id="ds-comment-name"
                    type="text"
                    placeholder={t.comments.required}
                    class="rounded-[var(--momo-radius-sm)] w-full text-[var(--text-color)] border border-[var(--button-border-color)] focus:outline-none focus:border-[var(--link-color)] text-sm p-2"
                  />
                </div>
                <div>
                  <label for="ds-comment-email" class="block text-sm text-[var(--text-color)] mb-1">
                    {t.comments.emailLabel}<span class="text-red-500">*</span>
                  </label>
                  <input
                    id="ds-comment-email"
                    type="email"
                    placeholder={t.comments.required}
                    class="rounded-[var(--momo-radius-sm)] w-full text-[var(--text-color)] border border-[var(--button-border-color)] focus:outline-none focus:border-[var(--link-color)] text-sm p-2"
                  />
                </div>
                <div>
                  <label for="ds-comment-site" class="block text-sm text-[var(--text-color)] mb-1">{t.comments.siteLabel}</label>
                  <input
                    id="ds-comment-site"
                    type="url"
                    placeholder={t.comments.optional}
                    class="rounded-[var(--momo-radius-sm)] w-full text-[var(--text-color)] border border-[var(--button-border-color)] focus:outline-none focus:border-[var(--link-color)] text-sm p-2"
                  />
                </div>
              </div>

              <textarea
                rows="4"
                placeholder={t.comments.placeholder}
                class="rounded-[var(--momo-radius-sm)] w-full border text-[var(--text-color)] border-[var(--button-border-color)] focus:outline-none focus:border-[var(--link-color)] text-sm p-3 min-h-[100px]"
              ></textarea>

              <div class="flex flex-wrap items-center justify-end gap-3">
                <button
                  type="button"
                  class="rounded-[var(--momo-radius-sm)] px-4 py-2 text-sm font-medium text-[var(--text-color)] border border-[var(--button-border-color)] hover:bg-[var(--button-hover-bg-color)]"
                >
                  {t.comments.preview}
                </button>
                <button
                  type="button"
                  class="rounded-[var(--momo-radius-sm)] px-4 py-2 text-sm font-medium text-[var(--text-color)] border border-[var(--button-border-color)] hover:bg-[var(--button-hover-bg-color)]"
                >
                  {t.comments.submit}
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- 16 状态 -->
        <section class="ds-section" id="state">
          <div class="ds-section-head">
            <span class="ds-index">16</span>
            <h2>{t.sections.state.title}</h2>
          </div>
          <p>{t.sections.state.desc}</p>
          <div class="ds-state-grid">
            <div class="ds-state">
              <span class="spinner" aria-hidden="true"></span>
              <strong>{t.states.loading}</strong>
              <span class="ds-hint">{t.states.loadingDesc}</span>
            </div>
            <div class="ds-state">
              <span style="font-size: var(--momo-font-size-4xl); line-height: 1">∅</span>
              <strong>{t.states.empty}</strong>
              <span class="ds-hint">{t.states.emptyDesc}</span>
            </div>
            <div class="ds-state">
              <span style="font-size: var(--momo-font-size-4xl); line-height: 1">!</span>
              <strong>{t.states.error}</strong>
              <span class="ds-hint">{t.states.errorDesc}</span>
              <button class="momo-btn momo-btn--sm" type="button">{t.states.retry}</button>
            </div>
          </div>
        </section>

        <!-- 17 无障碍 -->
        <section class="ds-section" id="a11y">
          <div class="ds-section-head">
            <span class="ds-index">17</span>
            <h2>{t.sections.a11y.title}</h2>
          </div>
          <p>{t.sections.a11y.desc}</p>

          <h3>{t.a11y.focus}</h3>
          <p class="ds-hint">{t.a11y.focusDesc}</p>
          <div class="ds-a11y-row">
            <button class="momo-btn" type="button">{t.a11y.focus}</button>
            <a class="ds-focus-demo" href="#color">{isEn ? 'A sample link' : '一个示例链接'}</a>
          </div>

          <h3>{t.a11y.labels} · {t.a11y.motion}</h3>
          <p class="ds-hint">{t.a11y.labelsDesc} {t.a11y.motionDesc}</p>
        </section>

        <!-- 18 样式归属 -->
        <section class="ds-section" id="structure">
          <div class="ds-section-head">
            <span class="ds-index">18</span>
            <h2>{t.sections.structure.title}</h2>
          </div>
          <p>{t.sections.structure.desc}</p>
          <div class="ds-prose-demo">
            <!-- 这层是手写的「长得像正文」的表，同样要退出入场动画：
                 Layout 的入场动画只作用于第一个 .markdown-content 的直接子元素，
                 不写 data-no-reveal 的话这张表会从 opacity: 0 开始、要滚进视口才淡入。 -->
            <div class="markdown-content" data-no-reveal>
              <table>
                <thead>
                  <tr>
                    <th>{isEn ? 'Layer' : '层级'}</th>
                    <th>{isEn ? 'Location' : '存放位置'}</th>
                    <th>{isEn ? 'Example' : '典型例子'}</th>
                  </tr>
                </thead>
                <tbody>
                  {structureRows.map((row) => (
                    <tr>
                      <td>{row[0]}</td>
                      <td><code>{row[1]}</code></td>
                      <td><code>{row[2]}</code></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</MainPageLayout>
