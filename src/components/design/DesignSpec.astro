/* --------------------------------------------------------------------------
 * 直接从 variables.css 读 token 值：规范页展示的永远是「正在生效的那一份」，
 * 改 token 不需要回来改文案。深色值从 [data-theme="dark"] 块里单独取。
 * ----------------------------------------------------------------------- */
function blockOf(source: string, pattern: RegExp) {
  return source.match(pattern)?.[1] ?? '';
}

function parseTokens(block: string) {
  const map: Record<string, string> = {};
  for (const match of block.matchAll(/(--[a-z0-9-]+)\s*:\s*([^;]+);/gi)) {
    map[match[1]] = match[2].replace(/\s+/g, ' ').trim();
  }
  return map;
}

const lightVars = parseTokens(blockOf(tokensCss, /:root\s*\{([\s\S]*?)\n\}/));
const darkVars = parseTokens(blockOf(tokensCss, /\[data-theme="dark"\]\s*\{([\s\S]*?)\n\}/));

const token = (name: string, dark = false) =>
  (dark ? darkVars[name] ?? lightVars[name] : lightVars[name]) ?? '—';

